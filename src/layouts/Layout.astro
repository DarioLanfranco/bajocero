---
import '../styles/globals.css';
import '../styles/utilities.css';
import '../styles/animations.css';
import '../styles/toast.css';

import Header from '../components/layout/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/layout/Footer.astro';

import { business } from '../data/business';
import { getSiteTitle, getSiteDescription, getJsonLd } from '../content/seo';
import { SITE_URL, OG_IMAGE } from '../config';
import { withBase } from '../utils/format';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = getSiteTitle(business),
  description = getSiteDescription(business),
  ogTitle,
  ogDescription,
} = Astro.props;

const jsonLdString = JSON.stringify(getJsonLd({ business, siteUrl: SITE_URL, ogImage: OG_IMAGE }));

const OG_TITLE = ogTitle ?? title;
const OG_DESCRIPTION = ogDescription ?? description;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121212" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://ik.imagekit.io; img-src 'self' https://ik.imagekit.io data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://docs.google.com; frame-src 'none'; object-src 'none'" />

    <link rel="preconnect" href="https://ik.imagekit.io" />
    <link rel="dns-prefetch" href="https://ik.imagekit.io" />

    <meta name="description" content={description} />

    <script src={withBase('/scripts/theme-init.js')} is:inline></script>

    <link rel="icon" type="image/svg+xml" href={withBase('/bajocero.svg')} />
    <link rel="alternate icon" type="image/x-icon" href={withBase('/bajocero.ico')} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="manifest" href={withBase('/manifest.json')} />
    <link rel="apple-touch-icon" href={withBase('/icon-192.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={OG_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={OG_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" is:inline>{jsonLdString}</script>

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import '../scripts/productCardErrorHandler';

      if (document.querySelector('[data-reveal]')) {
        import('../scripts/reveal');
      }

      if (document.getElementById('cart-btn')) {
        import('../scripts/cartToast').then((m) => m.initCartToast());
      }

      if ('serviceWorker' in navigator) {
        var hasIdleCallback = 'requestIdleCallback' in window;
        if (hasIdleCallback) {
          window.requestIdleCallback(function () {
            navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`);
          });
        } else {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`);
          });
        }
      }
    </script>
  </body>
</html>
