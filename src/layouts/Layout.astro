---
import '../styles/globals.css';
import '../styles/utilities.css';
import '../styles/animations.css';
import '../styles/toast.css';

import Header from '../components/layout/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/layout/Footer.astro';

import { business } from '../data/business';
import { getSiteTitle, getSiteDescription, getJsonLd } from '../content/seo';
import { SITE_URL, OG_IMAGE } from '../config';
import { withBase } from '../utils/format';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = getSiteTitle(business),
  description = getSiteDescription(business),
  ogTitle,
  ogDescription,
} = Astro.props;

const jsonLdString = JSON.stringify(getJsonLd({ business, siteUrl: SITE_URL, ogImage: OG_IMAGE }));

const OG_TITLE = ogTitle ?? title;
const OG_DESCRIPTION = ogDescription ?? description;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121212" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://ik.imagekit.io; img-src 'self' https://ik.imagekit.io data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://docs.google.com; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; form-action 'self'; base-uri 'self'" />

    <link rel="preconnect" href="https://ik.imagekit.io" />
    <link rel="dns-prefetch" href="https://ik.imagekit.io" />

    <link rel="preload" as="image" href={withBase('/assets/images/hero/header.webp')} fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;display=optional" fetchpriority="low" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;display=optional" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;display=optional" />
    </noscript>

    <meta name="description" content={description} />

    <script is:inline>(function(){try{var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:light)').matches?'light':'dark';document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.content=t==='dark'?'#121212':'#F9F6F0'}catch(e){document.documentElement.setAttribute('data-theme','dark')}})();</script>

    <link rel="icon" type="image/svg+xml" href={withBase('/bajocero.svg')} />
    <link rel="alternate icon" type="image/x-icon" href={withBase('/bajocero.ico')} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="manifest" href={withBase('/manifest.json')} />
    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 8px;
        z-index: var(--z-header, 100);
        padding: 8px 16px;
        background: var(--color-brand, #1F51FF);
        color: #fff;
        border-radius: 6px;
        font-size: var(--font-size-sm, 14px);
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 8px;
      }
      .skip-link:not(:focus) {
        position: absolute;
        top: -100%;
      }
    </style>
    <link rel="apple-touch-icon" href={withBase('/icon-192.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={OG_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={OG_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" is:inline>{jsonLdString}</script>

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      if (document.querySelector('.product-card')) {
        import('../scripts/productCardErrorHandler').then((m) => m.initProductCardErrorHandler());
      }

      if (document.querySelector('[data-reveal]')) {
        import('../scripts/reveal').catch(() => {});
      }

      import('../scripts/theme').then((m) => m.listenSystemThemeChanges()).catch(() => {});

      if ('serviceWorker' in navigator) {
        const registerSW = () => {
          navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`)
            .then((reg) => { reg.onupdatefound = () => {}; })
            .catch(() => {});
        };
        const hasIdleCallback = 'requestIdleCallback' in window;
        if (hasIdleCallback) {
          window.requestIdleCallback(registerSW);
        } else {
          window.addEventListener('load', registerSW);
        }
      }
    </script>
  </body>
</html>
