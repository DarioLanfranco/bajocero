---
import { business } from '../data/business';
import { sanitizePhoneNumber } from '../utils/phone';
import whatsappIcon from '../assets/images/whatsapp/wtsapp-svgrepo-com.svg';

const phone = sanitizePhoneNumber(business.whatsapp);
const message = '¡Hola! Vengo desde el catálogo web de Bajo Cero y me gustaría hacer una consulta.';
const waUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(message)}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-btn"
  aria-label="Contactar por WhatsApp"
>
  <img class="whatsapp-btn__icon" src={whatsappIcon.src} alt="" />
</a>

<script>
  (() => {
    const WHATSAPP_BTN_SEL = '.whatsapp-btn';
    const VISIBLE_CLASS = 'whatsapp-btn--visible';
    const SCROLL_THRESHOLD = 300;

    const btn = document.querySelector<HTMLAnchorElement>(WHATSAPP_BTN_SEL);
    if (!btn) return;

    let animating = false;

    function handleScroll(): void {
      const shouldShow = window.scrollY > SCROLL_THRESHOLD;
      const isVisible = btn.classList.contains(VISIBLE_CLASS);
      if (shouldShow === isVisible || animating) return;

      animating = true;
      btn.style.willChange = 'transform, opacity';
      btn.classList.toggle(VISIBLE_CLASS, shouldShow);

      const onEnd = () => {
        btn.style.willChange = '';
        animating = false;
        btn.removeEventListener('transitionend', onEnd);
      };
      btn.addEventListener('transitionend', onEnd, { once: true });
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  })();
</script>

<style>
  .whatsapp-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 140;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition:
      opacity 0.35s var(--easing-smooth),
      transform 0.35s var(--easing-smooth);
    text-decoration: none;
    line-height: 0;
  }

  .whatsapp-btn--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .whatsapp-btn__icon {
    display: block;
    width: 56px;
    height: 56px;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    transition: transform 0.25s var(--easing-smooth);
  }

  @media (hover: hover) {
    .whatsapp-btn:hover .whatsapp-btn__icon {
      transform: scale(1.1);
    }
  }

  .whatsapp-btn:active .whatsapp-btn__icon {
    transform: scale(0.92);
    transition-duration: 80ms;
  }

  @media (max-width: 767px) {
    .whatsapp-btn {
      bottom: 20px;
      right: 20px;
    }

    .whatsapp-btn__icon {
      width: 50px;
      height: 50px;
    }
  }
</style>
