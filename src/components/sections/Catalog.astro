---
import { products } from '../../data/products';
import { categories } from '../../data/categories';
import { productImageMap } from '../../data/productImages';
import ProductCard from '../catalog/ProductCard.astro';
---

<section class="catalog" id="productos" aria-label="Catálogo de productos">
  <div class="catalog__container container">
    <div class="catalog__header">
      <span class="catalog__eyebrow">Productos</span>
      <h2 class="catalog__title">
        Tu freezer,
        <span class="catalog__title-accent">tu mejor aliado</span>
      </h2>
    </div>

    {categories.map((category) => {
      const categoryProducts = products.filter((p) => p.category === category.name);
      if (categoryProducts.length === 0) return null;

      return (
        <div class="catalog__category">
          <h3 class="catalog__category-title">{category.name}</h3>

          <div class="catalog__grid">
            {categoryProducts.map((product) => (
              <ProductCard
                product={product}
                imageSrc={productImageMap[product.id]}
              />
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .catalog {
    padding: var(--space-3xl) 0;
  }

  .catalog__header {
    margin-bottom: var(--space-2xl);
  }

  .catalog__eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-mint);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-md);
  }

  .catalog__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-4xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.12;
    margin: 0;
  }

  .catalog__title-accent {
    display: block;
    color: var(--color-coral);
    margin-top: var(--space-xs);
  }

  .catalog__category {
    margin-bottom: var(--space-2xl);
  }

  .catalog__category:last-child {
    margin-bottom: 0;
  }

  .catalog__category-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-lg);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .catalog {
      padding: 96px 0;
    }

    .catalog__title {
      font-size: var(--font-size-5xl);
    }

    .catalog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .catalog__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
