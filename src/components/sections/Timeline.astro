---
import SectionHeading from '../ui/SectionHeading.astro';
import { timelineSteps } from '../../data/timeline';
---

<section class="timeline" id="como-funciona" aria-label="Cómo funciona Bajo Cero" data-reveal>
  <div class="timeline__container container">
    <div class="timeline__header" data-reveal data-reveal-delay="50">
      <SectionHeading
        eyebrow="Cómo funciona"
        titleStart="De tu freezer"
        titleAccent="a la mesa"
      />
    </div>

    <div class="timeline__rail" data-reveal data-reveal-stagger="children">
      {timelineSteps.map((step) => (
        <div class="timeline__step">
          <div class="timeline__step-marker" aria-hidden="true">
            <span class="timeline__step-number">{step.number}</span>
          </div>
          <div class="timeline__step-body">
            <h3 class="timeline__step-title">{step.title}</h3>
            <p class="timeline__step-text">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    padding: var(--space-3xl) 0;
  }

  .timeline__header {
    margin-bottom: var(--space-2xl);
  }

  .timeline__rail {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
  }

  .timeline__rail::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 1px;
    background: var(--color-border);
  }

  .timeline__step {
    position: relative;
    display: flex;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .timeline__step:last-child {
    padding-bottom: 0;
  }

  .timeline__step-marker {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .timeline__step-number {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .timeline__step-body {
    padding-top: 10px;
    flex: 1;
    min-width: 0;
  }

  .timeline__step-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-xs);
    line-height: 1.2;
  }

  .timeline__step-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  @media (min-width: 768px) {
    .timeline__step-title {
      font-size: var(--font-size-2xl);
    }

    .timeline__step-text {
      font-size: var(--font-size-base);
    }

    .timeline__step-marker {
      width: 56px;
      height: 56px;
    }

    .timeline__step-number {
      font-size: var(--font-size-lg);
    }

    .timeline__rail::before {
      left: 27px;
      top: 28px;
      bottom: 28px;
    }
  }
</style>
