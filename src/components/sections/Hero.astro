---
import headerImage from '../../assets/images/hero/header.webp';
---

<section
  class="hero"
  id="inicio"
  aria-label="Sección principal"
>
  <img
    class="hero__bg"
    src={headerImage.src}
    alt="Platos preparados Bajo Cero — Comida congelada de calidad"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />

  <div class="hero__content container">
    <div class="hero__text">
      <div class="hero__badge" data-reveal>
        <span class="hero__badge-dot" aria-hidden="true"></span>
        Abierto ahora
        <span class="hero__badge-separator" aria-hidden="true"></span>
        <span class="hero__badge-hours">Take Away 9:00–14:00 | 16:00–20:30</span>
      </div>

      <h1 class="hero__title" data-reveal data-reveal-delay="100">El sabor del instante.</h1>

      <p class="hero__subtitle" data-reveal data-reveal-delay="200">De tu freezer a la mesa en minutos.</p>

      <p class="hero__description" data-reveal data-reveal-delay="300">
        Descubrí una experiencia gastronómica única con ingredientes seleccionados y preparaciones listas para disfrutar en cualquier momento.
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="400">
        <a href="productos" class="hero__btn hero__btn--primary">
          Ver Productos
        </a>
        <a href="#conocenos" class="hero__btn hero__btn--secondary">
          Conócenos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    will-change: transform;
    animation: hero-zoom 20s ease-out forwards;
  }

  @keyframes hero-zoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  /* Main overlay — progressive darkening left to right */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-gradient);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  /* Secondary overlay — cinematic vignette */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--hero-vignette);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  .hero__text {
    max-width: var(--content-max-width);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px 16px;
    border: 1px solid var(--color-mint);
    border-radius: var(--radius-full);
    background-color: rgba(0, 191, 166, 0.08);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-mint);
    margin-bottom: var(--space-xl);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-mint);
    flex-shrink: 0;
    animation: badge-pulse 2s ease-in-out infinite;
  }

  @keyframes badge-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__badge-separator {
    width: 1px;
    height: 14px;
    background-color: rgba(0, 191, 166, 0.35);
  }

  .hero__badge-hours {
    color: rgba(0, 191, 166, 0.7);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-6xl);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .hero__subtitle {
    font-size: var(--font-size-2xl);
    font-weight: 500;
    color: var(--color-coral);
    line-height: 1.3;
    margin-bottom: var(--space-lg);
    font-family: var(--font-heading);
    transition: color 0.3s ease;
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: var(--space-2xl);
    transition: color 0.3s ease;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: var(--font-size-base);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
    line-height: 1;
    text-align: center;
    cursor: pointer;
    will-change: transform, box-shadow;
  }

  @media (hover: hover) {
    .hero__btn:hover,
    .hero__btn:focus-visible {
      transform: translateY(-2px);
    }

    .hero__btn--primary:hover,
    .hero__btn--primary:focus-visible {
      opacity: 1;
      box-shadow: 0 4px 16px rgba(255, 90, 95, 0.3);
    }

    .hero__btn--secondary:hover,
    .hero__btn--secondary:focus-visible {
      border-color: rgba(255, 255, 255, 0.5);
      box-shadow: 0 4px 16px rgba(255, 255, 255, 0.08);
    }
  }

  .hero__btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  @media (max-width: 1023px) {
    .hero__title {
      font-size: var(--font-size-5xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-xl);
    }

    .hero__description {
      font-size: var(--font-size-base);
    }

    .hero__content {
      padding-top: calc(var(--header-height-mobile) + var(--space-2xl));
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 100vh;
      background-position: 65% center;
    }

    @supports (min-height: 100dvh) {
      .hero {
        min-height: 100dvh;
      }
    }

    .hero__bg {
      object-position: 65% center;
    }

    .hero__content {
      padding-left: var(--space-md);
      padding-right: var(--space-md);
    }

    .hero__text {
      max-width: 100%;
    }

    .hero::before {
      background: var(--hero-gradient);
    }

    .hero__title {
      font-size: var(--font-size-4xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-lg);
    }

    .hero__description {
      font-size: var(--font-size-sm);
      max-width: 100%;
    }

    .hero__badge {
      font-size: var(--font-size-xs);
      padding: 4px 12px;
    }

    .hero__btn {
      padding: 14px 24px;
      font-size: var(--font-size-sm);
      flex: 1;
    }

    .hero__actions {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: var(--font-size-3xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-base);
    }
  }
</style>
