---
import { Image } from "astro:assets";
import heroSrc from "../../assets/images/hero/header.webp";
import HeroContent from "./HeroContent.astro";
---

<section class="hero" id="inicio" aria-label="Sección principal">
  <Image
    class="hero__bg"
    src={heroSrc}
    alt="Platos preparados Bajo Cero — Comida congelada de calidad"
    widths={[320, 480, 768, 1024, 1920]}
    sizes="100vw"
    format="webp"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />

  <div class="hero__content container">
    <HeroContent />
  </div>
</section>

<style>
  @import "../../styles/breakpoints.css";
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__bg {
      transform: scale(1.08);
      animation: hero-zoom 20s ease-out forwards;
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-gradient);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--hero-vignette);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  @media (--bp-lg-down) {
    .hero__content {
      padding-top: calc(var(--header-height-mobile) + var(--space-2xl));
    }
  }

  @media (--bp-md-down) {
    .hero {
      min-height: 100vh;
      background-position: 65% center;
    }

    @supports (min-height: 100dvh) {
      .hero {
        min-height: 100dvh;
      }
    }

    .hero__bg {
      object-position: 65% center;
    }

    .hero__content {
      padding-left: var(--space-md);
      padding-right: var(--space-md);
    }

    .hero::before {
      background: var(--hero-gradient);
    }
  }
</style>
