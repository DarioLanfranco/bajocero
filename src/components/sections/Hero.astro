---
import headerImage from "../../assets/images/hero/header.webp";
import StatusBadge from "../ui/StatusBadge.astro";
---

<section class="hero" id="inicio" aria-label="Sección principal">
  <img
    class="hero__bg"
    src={headerImage.src}
    alt="Platos preparados Bajo Cero — Comida congelada de calidad"
    fetchpriority="high"
    loading="eager"
    decoding="async"
  />

  <div class="hero__content container">
    <div class="hero__text">
      <StatusBadge />

      <h1 class="hero__title" data-reveal data-reveal-delay="100">
        El sabor del instante.
      </h1>

      <p class="hero__subtitle" data-reveal data-reveal-delay="200">
        De tu freezer a la mesa en minutos.
      </p>

      <p class="hero__description" data-reveal data-reveal-delay="300">
        Descubrí una experiencia gastronómica única con ingredientes
        seleccionados y preparaciones listas para disfrutar en cualquier
        momento.
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="400">
        <a href="/productos" class="hero__btn hero__btn--primary">
          Ver Productos
        </a>
        <a href="/conocenos" class="hero__btn hero__btn--secondary">
          Conócenos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    animation: hero-zoom 20s ease-out forwards;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  /* Main overlay — progressive darkening left to right */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-gradient);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  /* Secondary overlay — cinematic vignette */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--hero-vignette);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  .hero__text {
    max-width: var(--content-max-width);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-6xl);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .hero__subtitle {
    font-size: var(--font-size-2xl);
    font-weight: 500;
    color: var(--color-coral);
    line-height: 1.3;
    margin-bottom: var(--space-lg);
    font-family: var(--font-heading);
    transition: color 0.3s ease;
  }

  .hero__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: var(--space-2xl);
    transition: color 0.3s ease;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    font-size: var(--font-size-base);
    font-weight: 600;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    border: 1px solid;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .hero__btn--primary {
    background-color: var(--color-coral);
    color: #fff;
    border-color: var(--color-coral);
    box-shadow:
      0 0 12px rgba(var(--color-brand-rgb), 0.18),
      0 0 24px rgba(var(--color-brand-rgb), 0.1);
  }

  .hero__btn--secondary {
    background-color: transparent;
    color: var(--color-text);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow:
      0 0 8px rgba(var(--color-brand-rgb), 0.08),
      0 0 16px rgba(var(--color-brand-rgb), 0.04);
  }

  [data-theme="light"] .hero__btn--primary {
    box-shadow:
      0 0 8px rgba(var(--color-brand-rgb), 0.12),
      0 0 16px rgba(var(--color-brand-rgb), 0.06);
  }

  [data-theme="light"] .hero__btn--secondary {
    border-color: rgba(18, 18, 18, 0.4);
    box-shadow:
      0 0 6px rgba(var(--color-brand-rgb), 0.05);
  }

  @media (hover: hover) {
    .hero__btn:hover,
    .hero__btn:focus-visible {
      transform: translateY(-2px);
    }

    .hero__btn--primary:hover,
    .hero__btn--primary:focus-visible {
      box-shadow:
        0 0 12px rgba(var(--color-brand-rgb), 0.4),
        0 0 28px rgba(var(--color-brand-rgb), 0.25),
        0 0 56px rgba(var(--color-brand-rgb), 0.12);
    }

    .hero__btn--secondary:hover,
    .hero__btn--secondary:focus-visible {
      border-color: #fff;
      box-shadow:
        0 0 8px rgba(var(--color-brand-rgb), 0.35),
        0 0 22px rgba(var(--color-brand-rgb), 0.2),
        0 0 44px rgba(var(--color-brand-rgb), 0.1);
      text-shadow:
        0 0 8px rgba(255, 255, 255, 0.3),
        0 0 16px rgba(var(--color-brand-rgb), 0.2);
    }

    [data-theme="light"] .hero__btn--primary:hover,
    [data-theme="light"] .hero__btn--primary:focus-visible {
      box-shadow:
        0 0 10px rgba(var(--color-brand-rgb), 0.3),
        0 0 22px rgba(var(--color-brand-rgb), 0.15);
    }

    [data-theme="light"] .hero__btn--secondary:hover,
    [data-theme="light"] .hero__btn--secondary:focus-visible {
      border-color: rgba(18, 18, 18, 0.8);
      box-shadow:
        0 0 8px rgba(var(--color-brand-rgb), 0.25),
        0 0 18px rgba(var(--color-brand-rgb), 0.12);
      text-shadow:
        0 0 8px rgba(var(--color-brand-rgb), 0.15);
    }
  }

  .hero__btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  @media (max-width: 1023px) {
    .hero__title {
      font-size: var(--font-size-5xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-xl);
    }

    .hero__description {
      font-size: var(--font-size-base);
    }

    .hero__content {
      padding-top: calc(var(--header-height-mobile) + var(--space-2xl));
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 100vh;
      background-position: 65% center;
    }

    @supports (min-height: 100dvh) {
      .hero {
        min-height: 100dvh;
      }
    }

    .hero__bg {
      object-position: 65% center;
    }

    .hero__content {
      padding-left: var(--space-md);
      padding-right: var(--space-md);
    }

    .hero__text {
      max-width: 100%;
    }

    .hero::before {
      background: var(--hero-gradient);
    }

    .hero__title {
      font-size: var(--font-size-4xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-lg);
    }

    .hero__description {
      font-size: var(--font-size-sm);
      max-width: 100%;
    }

    .hero__btn {
      padding: 14px 24px;
      font-size: var(--font-size-sm);
      flex: 1;
    }

    .hero__actions {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: var(--font-size-3xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-base);
    }
  }
</style>
