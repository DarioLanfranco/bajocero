---
import Map from "../map/Map.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { business } from "../../data/business";
import Icon from "../ui/Icon.astro";
---

<section
  id="ubicacion"
  class="location"
  aria-label="Ubicación y contacto"
  data-reveal
>
  <div class="location__container container">
    <div class="location__grid">
      <div class="location__info" data-reveal>
        <SectionHeading eyebrow="VISÍTANOS" titleStart="Ubicación y Contacto" />

        <div class="location__item" data-reveal data-reveal-delay="100">
          <Icon
            name="map-pin"
            size={18}
            strokeWidth={2}
            class="location__icon"
          />
          <address class="location__address">
            <p class="location__label">Dirección</p>
            <p class="location__value">Av. Roberto Payró 913</p>
            <p class="location__sub">Río Cuarto, Córdoba, Argentina</p>
          </address>
        </div>

        <div class="location__item" data-reveal data-reveal-delay="150">
          <Icon name="clock" size={18} strokeWidth={2} class="location__icon" />
          <div class="location__hours">
            <p class="location__label">Horario de Take Away</p>
            {
              business.hours.map((h) => (
                <div class="location__hours-row">
                  <span class="location__hours-days">{h.days}</span>
                  <span
                    class="location__hours-time"
                    class:list={{
                      "location__hours-time--closed": h.hours === "Cerrado",
                    }}
                  >
                    {h.hours}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="location__item" data-reveal data-reveal-delay="200">
          <Icon name="phone" size={18} strokeWidth={2} class="location__icon" />
          <div>
            <p class="location__label">Contacto</p>
            <a
              href="https://wa.me/543586006854"
              target="_blank"
              rel="noopener noreferrer"
              class="location__link"
            >
              +54 358 4201263
            </a>
            <a
              href="https://www.instagram.com/bajocero.riocuarto"
              target="_blank"
              rel="noopener noreferrer"
              class="location__link"
            >
              @bajocero.riocuarto
            </a>
          </div>
        </div>
      </div>

      <div class="location__map" data-reveal data-reveal-delay="200">
        <Map />
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    padding: var(--space-3xl) 0;
  }

  .location__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  .location__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: var(--space-lg);
    padding: 12px;
    border-radius: 8px;
    transition: background var(--transition-fast);
  }

  @media (hover: hover) {
    .location__item:hover {
      background: rgba(var(--color-brand-rgb), 0.04);
    }
  }

  .location__icon {
    margin-top: 2px;
    flex-shrink: 0;
    color: var(--color-brand);
  }

  .location__label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .location__value {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
  }

  .location__sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .location__hours {
    flex: 1;
    min-width: 0;
  }

  .location__hours-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--font-size-sm);
    margin-top: var(--space-sm);
  }

  .location__hours-days {
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .location__hours-time {
    color: var(--color-text);
    font-weight: 500;
    text-align: right;
    line-height: 1.5;
  }

  .location__hours-time--closed {
    color: var(--color-brand);
    font-weight: 600;
  }

  .location__link {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    margin-top: 2px;
  }

  .location__link:hover,
  .location__link:focus-visible {
    color: var(--color-text);
  }

  .location__map {
    position: relative;
  }

  @media (min-width: 768px) {
    .location {
      padding: 96px 0;
    }

    .location__grid {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-3xl);
    }

    .location__map {
      position: sticky;
      top: 96px;
    }
  }
</style>
