---
import Map from "../map/Map.astro";
import LocationInfo from "./LocationInfo.astro";
import { business } from "../../data/business";
---

<section
  id="ubicacion"
  class="location"
  aria-label="Ubicación y contacto"
  data-reveal
>
  <div class="location__container container">
    <div class="location__grid">
      <LocationInfo business={business} />

      <div class="location__map" data-reveal data-reveal-delay="200">
        <Map />
      </div>
    </div>
  </div>
</section>

<style>
  @import "../../styles/breakpoints.css";
  .location {
    padding: var(--space-3xl) 0;
  }

  [data-theme="light"] .location {
    background: #FFFFFF;
  }

  .location__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .location__map {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  @media (--bp-md-up) {
    .location {
      padding: 96px 0;
    }

    .location__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }
  }
</style>
