---
import Map from '../map/Map.astro';
---

<section
  id="ubicacion"
  class="scroll-mt-[72px] lg:scroll-mt-20 py-16 md:py-24"
  aria-label="Ubicación y contacto"
>
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-[2fr_3fr] gap-10 md:gap-12 items-start">
      <!-- Left: Info column -->
      <div>
        <span class="text-xs text-mint tracking-[0.2em] font-semibold">
          VISÍTANOS
        </span>

        <h2
          class="mt-2 mb-8 font-heading text-3xl md:text-4xl font-bold text-text-primary leading-tight"
        >
          Ubicación y Contacto
        </h2>

        <!-- Dirección -->
        <div class="flex items-start gap-3 mb-6">
          <svg class="mt-0.5 shrink-0 text-mint" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <div>
            <p class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-1">
              Dirección
            </p>
            <p class="text-base font-bold text-text-primary">
              Av. Roberto Payró 913
            </p>
            <p class="text-sm text-text-secondary mt-0.5">
              Río Cuarto, Córdoba, Argentina
            </p>
          </div>
        </div>

        <!-- Horario de Take Away -->
        <div class="flex items-start gap-3 mb-6">
          <svg class="mt-0.5 shrink-0 text-mint" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-3">
              Horario de Take Away
            </p>
            <div class="flex justify-between items-baseline gap-4 text-sm">
              <span class="text-text-secondary shrink-0">Lunes – Sábados</span>
              <span class="text-text-primary text-right font-medium leading-relaxed">
                9:00 – 14:00 | 16:00 – 20:30
              </span>
            </div>
            <div class="flex justify-between items-baseline gap-4 text-sm mt-2">
              <span class="text-text-secondary shrink-0">Domingos y Feriados</span>
              <span class="text-coral font-semibold">Cerrado</span>
            </div>
          </div>
        </div>

        <!-- Contacto -->
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 shrink-0 text-mint" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          <div>
            <p class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-2">
              Contacto
            </p>
            <a
              href="https://wa.me/543584201263"
              target="_blank"
              rel="noopener noreferrer"
              class="block text-sm text-text-secondary hover:text-text-primary transition-colors mb-1.5"
            >
              +54 358 4201263
            </a>
            <a
              href="https://instagram.com/bajocerooficial"
              target="_blank"
              rel="noopener noreferrer"
              class="block text-sm text-text-secondary hover:text-text-primary transition-colors"
            >
              @bajocerooficial
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Map -->
      <div class="md:sticky md:top-24">
        <Map />
      </div>
    </div>
  </div>
</section>
