---
import Map from '../map/Map.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section
  id="ubicacion"
  class="location"
  aria-label="Ubicación y contacto"
>
  <div class="location__container container">
    <div class="location__grid">
      <div class="location__info">
        <SectionHeading
          eyebrow="VISÍTANOS"
          titleStart="Ubicación y Contacto"
        />

        <div class="location__item">
          <svg class="location__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <address class="location__address">
            <p class="location__label">Dirección</p>
            <p class="location__value">Av. Roberto Payró 913</p>
            <p class="location__sub">Río Cuarto, Córdoba, Argentina</p>
          </address>
        </div>

        <div class="location__item">
          <svg class="location__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <div class="location__hours">
            <p class="location__label">Horario de Take Away</p>
            <div class="location__hours-row">
              <span class="location__hours-days">Lunes – Sábados</span>
              <span class="location__hours-time">9:00 – 14:00 | 16:00 – 20:30</span>
            </div>
            <div class="location__hours-row">
              <span class="location__hours-days">Domingos y Feriados</span>
              <span class="location__hours-time location__hours-time--closed">Cerrado</span>
            </div>
          </div>
        </div>

        <div class="location__item">
          <svg class="location__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          <div>
            <p class="location__label">Contacto</p>
            <a href="https://wa.me/543584201263" target="_blank" rel="noopener noreferrer" class="location__link">
              +54 358 4201263
            </a>
            <a href="https://instagram.com/bajocerooficial" target="_blank" rel="noopener noreferrer" class="location__link">
              @bajocerooficial
            </a>
          </div>
        </div>
      </div>

      <div class="location__map">
        <Map />
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    padding: var(--space-3xl) 0;
  }

  .location__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  .location__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: var(--space-lg);
  }

  .location__icon {
    margin-top: 2px;
    flex-shrink: 0;
    color: var(--color-mint);
  }

  .location__label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .location__value {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
  }

  .location__sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .location__hours {
    flex: 1;
    min-width: 0;
  }

  .location__hours-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--font-size-sm);
    margin-top: var(--space-sm);
  }

  .location__hours-days {
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .location__hours-time {
    color: var(--color-text);
    font-weight: 500;
    text-align: right;
    line-height: 1.5;
  }

  .location__hours-time--closed {
    color: var(--color-coral);
    font-weight: 600;
  }

  .location__link {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    margin-top: 2px;
  }

  .location__link:hover,
  .location__link:focus-visible {
    color: var(--color-text);
  }

  .location__map {
    position: relative;
  }

  @media (min-width: 768px) {
    .location {
      padding: 96px 0;
    }

    .location__grid {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-3xl);
    }

    .location__map {
      position: sticky;
      top: 96px;
    }
  }
</style>
