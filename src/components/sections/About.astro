---
import AboutCards from './AboutCards.astro';
import AboutMetrics from './AboutMetrics.astro';
---

<section class="about" id="conocenos" aria-label="Sobre Bajo Cero" data-reveal>
  <div class="about__container container">
    <div class="about__grid">
      <span class="about__eyebrow" data-reveal data-reveal-delay="50">CONÓCENOS</span>

      <h2 class="about__title" data-reveal data-reveal-delay="100">
        La ciencia detrás del sabor.
        <span class="about__title-accent">Del freezer al fuego</span>
        sin perder frescura.
      </h2>

      <p class="about__description" data-reveal data-reveal-delay="150">
        En Bajocero transformamos ingredientes seleccionados en platos listos para disfrutar. Nuestro proceso de supercongelación IQF preserva el sabor y los nutrientes, para que tengas comida de calidad siempre disponible en tu freezer. Rápido, conveniente y delicioso.
      </p>

      <AboutCards />
      <AboutMetrics />

      <a href="productos" class="about__btn" data-reveal data-reveal-delay="300">Explorar Catálogo</a>
    </div>

    <div class="about__trust" data-reveal data-reveal-delay="250">
      Productos seleccionados para acompañar tu día a día.
    </div>
  </div>
</section>

<style>
  .about {
    padding: 64px 0;
    position: relative;
  }

  .about__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .about__eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-mint);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-md);
  }

  .about__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .about__title-accent {
    display: block;
    color: var(--color-coral);
    margin-top: var(--space-sm);
  }

  .about__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 560px;
  }

  .about__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    background-color: var(--color-coral);
    color: var(--color-text);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    font-weight: 600;
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast),
      box-shadow var(--transition-fast);
    line-height: 1;
    width: fit-content;
    will-change: transform, box-shadow;
  }

  @media (hover: hover) {
    .about__btn:hover,
    .about__btn:focus-visible {
      transform: translateY(-2px);
      opacity: 1;
      box-shadow: 0 4px 16px rgba(var(--color-coral-rgb), 0.3);
    }
  }

  .about__btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .about__trust {
    margin-top: var(--space-2xl);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .about {
      padding: 96px 0;
    }

    .about__grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-rows: auto auto auto auto;
    }

    .about__eyebrow {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .about__title {
      grid-column: 1;
      grid-row: 2;
      margin-bottom: 0;
    }

    .about__description {
      grid-column: 1;
      grid-row: 3;
      margin-bottom: 0;
    }

    .about__cards {
      grid-column: 2;
      grid-row: 1 / 5;
    }

    .about__metrics {
      grid-column: 1;
      grid-row: 4;
    }

    .about__btn {
      grid-column: 1;
      grid-row: 5;
    }
  }

  @media (max-width: 1023px) {
    .about__title {
      font-size: var(--font-size-4xl);
    }

    .about__description {
      font-size: var(--font-size-base);
    }
  }

  @media (max-width: 767px) {
    .about__title {
      font-size: var(--font-size-3xl);
    }

    .about__btn {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .about__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
