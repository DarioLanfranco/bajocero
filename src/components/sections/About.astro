---
import AboutText from './AboutText.astro';
import AboutCards from './AboutCards.astro';
---

<section class="about" id="conocenos" aria-label="Sobre Bajo Cero" data-reveal>
  <div class="about__container container">
    <div class="about__grid">
      <AboutText />

      <div class="about__right" data-reveal data-reveal-delay="200">
        <AboutCards />
      </div>
    </div>
  </div>
</section>

<style>
  @import "../../styles/breakpoints.css";
  .about {
    padding: 64px 0;
    position: relative;
  }

  .about__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .about__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (--bp-lg-up) {
    .about {
      padding: 96px 0;
    }

    .about__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-3xl);
      align-items: start;
    }

    .about__right {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
    }
  }
</style>
