---
import AboutCards from './AboutCards.astro';
import AboutMetrics from './AboutMetrics.astro';
---

<section class="about" id="conocenos" aria-label="Sobre Bajo Cero" data-reveal>
  <div class="about__container container">
    <div class="about__grid">
      <div class="about__left">
        <span class="about__eyebrow" data-reveal data-reveal-delay="50">CONÓCENOS</span>

        <h2 class="about__title" data-reveal data-reveal-delay="100">
          La ciencia detrás del sabor.
          <span class="about__title-accent">Del freezer al fuego</span>
          sin perder frescura.
        </h2>

        <p class="about__description" data-reveal data-reveal-delay="150">
          En Bajocero transformamos ingredientes seleccionados en platos listos para disfrutar. Nuestro proceso de supercongelación IQF preserva el sabor y los nutrientes, para que tengas comida de calidad siempre disponible en tu freezer. Rápido, conveniente y delicioso.
        </p>

        <AboutMetrics />

        <a href="/productos" class="about__btn" data-reveal data-reveal-delay="300">
          Explorar Catálogo <span class="about__btn-arrow">→</span>
        </a>
      </div>

      <div class="about__right" data-reveal data-reveal-delay="200">
        <AboutCards />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 64px 0;
    position: relative;
  }

  .about__grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .about__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about__eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .about__eyebrow::after {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    margin-top: 8px;
    background: var(--color-brand);
    border-radius: 2px;
  }

  .about__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .about__title-accent {
    display: block;
    color: var(--color-brand);
    margin-top: var(--space-sm);
  }

  .about__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 560px;
  }

  .about__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 28px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    font-weight: 500;
    width: fit-content;
    text-decoration: none;
    transition:
      background var(--transition-normal),
      box-shadow var(--transition-normal),
      transform var(--transition-fast);
    line-height: 1;
  }

  .about__btn-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  @media (hover: hover) {
    .about__btn:hover,
    .about__btn:focus-visible {
      background: rgba(var(--color-brand-rgb), 0.06);
      box-shadow:
        0 0 12px rgba(var(--color-brand-rgb), 0.18),
        0 0 24px rgba(var(--color-brand-rgb), 0.1);
      transform: translateY(-1px);
    }

    .about__btn:hover .about__btn-arrow {
      transform: translateX(4px);
    }
  }

  .about__btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .about__right {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .about {
      padding: 96px 0;
    }

    .about__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-3xl);
      align-items: start;
    }

    .about__left {
      gap: var(--space-xl);
    }

    .about__title {
      font-size: var(--font-size-5xl);
    }

    .about__description {
      font-size: var(--font-size-lg);
    }

    .about__right {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
    }
  }

  @media (max-width: 1023px) {
    .about__title {
      font-size: var(--font-size-4xl);
    }

    .about__description {
      font-size: var(--font-size-base);
    }
  }

  @media (max-width: 767px) {
    .about__title {
      font-size: var(--font-size-3xl);
    }

    .about__btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .about__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
