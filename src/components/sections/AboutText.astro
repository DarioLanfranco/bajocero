---
import { withBase } from "../../utils/format";
import AboutMetrics from "./AboutMetrics.astro";
---

<div class="about__left">
  <span class="about__eyebrow" data-reveal data-reveal-delay="50"
    >CONÓCENOS</span
  >

  <h2 class="about__title" data-reveal data-reveal-delay="100">
    La ciencia detrás del sabor.
    <span class="about__title-accent">Del freezer al fuego</span>
    sin perder frescura.
  </h2>

  <p class="about__description" data-reveal data-reveal-delay="150">
    En Bajocero seleccionamos y distribuimos las mejores opciones de platos
    supercongelados IQF del mercado. Nos encargamos de acercarte productos de
    máxima calidad que preservan todo su sabor y nutrientes, para que tengas
    comida de primer nivel siempre lista en tu freezer. Rápido, conveniente y
    delicioso.
  </p>

  <AboutMetrics />

  <a
    href={withBase("/productos")}
    class="about__btn"
    data-reveal
    data-reveal-delay="300"
  >
    Explorar Catálogo <span class="about__btn-arrow">→</span>
  </a>
</div>

<style>
  .about__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about__eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .about__eyebrow::after {
    content: "";
    display: block;
    width: 40px;
    height: 2px;
    margin-top: 8px;
    background: var(--color-brand);
    border-radius: 2px;
  }

  .about__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-5xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .about__title-accent {
    display: block;
    color: var(--color-brand);
    margin-top: var(--space-sm);
  }

  .about__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 560px;
  }

  .about__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 28px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    font-weight: 500;
    width: fit-content;
    text-decoration: none;
    transition:
      background var(--transition-normal),
      box-shadow var(--transition-normal),
      transform var(--transition-fast);
    line-height: 1;
  }

  .about__btn-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  @media (hover: hover) {
    .about__btn:hover,
    .about__btn:focus-visible {
      background: rgba(var(--color-brand-rgb), 0.06);
      box-shadow:
        0 0 12px rgba(var(--color-brand-rgb), 0.18),
        0 0 24px rgba(var(--color-brand-rgb), 0.1);
      transform: translateY(-1px);
    }

    .about__btn:hover .about__btn-arrow {
      transform: translateX(4px);
    }
  }

  .about__btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  @media (max-width: 1023px) {
    .about__title {
      font-size: var(--font-size-4xl);
    }

    .about__description {
      font-size: var(--font-size-base);
    }
  }

  @media (max-width: 767px) {
    .about__title {
      font-size: var(--font-size-3xl);
    }

    .about__btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .about__title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
