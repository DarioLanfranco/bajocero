---
import { reviews } from '../../data/reviews';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  sectionId?: string;
}

const { sectionId = 'opiniones' } = Astro.props;
---

<section class="reviews" id={sectionId} aria-label="Opiniones de clientes" data-reveal>
  <div class="reviews__container container">
    <div class="reviews__header" data-reveal>
      <SectionHeading
        eyebrow="TESTIMONIOS"
        titleStart="Opiniones Reales"
      />
      <p class="reviews__subtitle" data-reveal data-reveal-delay="100">
        La transparencia es nuestra base. Esto es lo que dicen nuestros clientes.
      </p>
    </div>

    <div class="reviews__grid" data-reveal data-reveal-stagger="children" data-reveal-delay="150">
      {reviews.map((review) => (
        <article class="review-card">
          <div class="review-card__stars" aria-label="5 estrellas">
            <Icon name="star-filled" size={18} strokeWidth={0} /><Icon name="star-filled" size={18} strokeWidth={0} /><Icon name="star-filled" size={18} strokeWidth={0} /><Icon name="star-filled" size={18} strokeWidth={0} /><Icon name="star-filled" size={18} strokeWidth={0} />
          </div>
          <blockquote class="review-card__text">"{review.text}"</blockquote>
          <footer class="review-card__author">
            <span class="review-card__name">{review.name}</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews {
    padding: var(--space-3xl) 0;
    position: relative;
  }

  .reviews__container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .reviews__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .reviews__subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 480px;
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-xl);
    transition:
      border-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  @media (hover: hover) {
    .review-card:hover {
      border-color: var(--color-text-tertiary);
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
    }
  }

  .review-card__stars {
    font-size: var(--font-size-lg);
    line-height: 1;
    color: var(--color-brand);
    letter-spacing: 2px;
    transition: filter 0.3s ease;
  }

  @media (hover: hover) {
    .review-card:hover .review-card__stars {
      filter: drop-shadow(0 0 6px rgba(var(--color-brand-rgb), 0.3));
    }
  }

  .review-card__text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    font-style: normal;
    margin: 0;
  }

  .review-card__author {
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .review-card__name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    display: block;
  }

  @media (min-width: 768px) {
    .reviews {
      padding: var(--space-3xl) 0;
    }

    .reviews__subtitle {
      font-size: var(--font-size-lg);
    }

    .reviews__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .reviews {
      padding: 96px 0;
    }
  }
</style>
