---
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import InstagramCtaCard from './InstagramCtaCard.astro';

export interface Props {
  images: ImageMetadata[];
  ctaImage: ImageMetadata;
  instagramUrl: string;
  instagramHandle: string;
}

const { images, ctaImage, instagramUrl, instagramHandle } = Astro.props;
---

<section class="feed" aria-label="Galería de Instagram" data-reveal>
  <div class="feed__container container">
    <div class="feed__header" data-reveal>
      <SectionHeading
        eyebrow="Instagram"
        titleStart="Vida en"
        titleAccent="Bajo Cero"
      />
    </div>

    <ul class="feed__grid" data-reveal data-reveal-delay="100">
      {
        images.map((img) => (
          <li class="feed__item">
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="feed__link"
            >
              <img
                class="feed__img"
                src={img.src}
                alt="Bajo Cero - Instagram"
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
      <InstagramCtaCard
        image={ctaImage}
        instagramUrl={instagramUrl}
        instagramHandle={instagramHandle}
      />
    </ul>
  </div>
</section>

<style>
  @import "../../styles/breakpoints.css";
  .feed {
    padding: var(--space-3xl) 0;
    background-color: rgba(var(--color-brand-rgb), 0.02);
  }

  @media (--bp-lg-up) {
    .feed {
      padding: 96px 0;
    }
  }

  .feed__header {
    margin-bottom: var(--space-2xl);
  }

  .feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feed__item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface-subtle);
  }

  .feed__item::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(var(--color-brand-rgb), 0.1);
    border-radius: 16px;
    pointer-events: none;
    z-index: 5;
  }

  .feed__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .feed__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .feed__link:hover .feed__img {
      transform: scale(1.03);
      filter: brightness(1.06) saturate(1.12);
    }
  }

  @media (--bp-md-up) {
    .feed__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
