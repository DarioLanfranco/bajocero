---
import { business } from '../../data/business';
---

<div class="map">
  <iframe
    class="map__iframe"
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3342.474038526535!2d-64.34505419999999!3d-33.09661929999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95d201004daf634b%3A0x385cac196230969e!2sBajo%20Cero%20Congelados!5e0!3m2!1ses!2sar!4v1784937161608!5m2!1ses!2sar"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    title="Ubicación de Bajo Cero — {business.addressShort}"
  ></iframe>

  <div class="map__marker" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
      <circle cx="12" cy="10" r="3" fill="var(--color-bg)"/>
    </svg>
    <span class="map__marker-label">{business.addressShort}</span>
  </div>
</div>

<style>
  .map {
    position: relative;
    width: 100%;
    background-color: var(--color-bg);
  }

  .map__iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
    display: block;
  }

  .map__marker {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 8px 12px;
    background-color: rgba(13, 17, 23, 0.85);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    pointer-events: none;
    user-select: none;
  }

  .map__marker svg {
    flex-shrink: 0;
    color: var(--color-brand);
  }

  .map__marker-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .map__iframe {
      min-height: 400px;
    }
  }
</style>
