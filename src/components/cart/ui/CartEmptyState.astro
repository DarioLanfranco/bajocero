---
import Icon from '../../ui/Icon.astro';
import { withBase } from '../../../utils/format';
---

<div id="cart-empty" class="cart-drawer__empty" data-cart-role="empty">
  <Icon name="cart" size={48} strokeWidth={1.5} />
  <p class="cart-drawer__empty-text">Tu carrito está vacío</p>
  <p class="cart-drawer__empty-sub">Agregá productos para comenzar tu pedido.</p>
  <a href={withBase('/productos')} class="cart-drawer__cta-btn">Explorar productos</a>
</div>

<style>
  #cart-empty[hidden] {
    display: none;
  }

  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: var(--space-md);
    padding: var(--space-2xl);
    text-align: center;
  }

  .cart-drawer__empty svg {
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-sm);
  }

  .cart-drawer__empty-text {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  .cart-drawer__empty-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 260px;
  }

  .cart-drawer__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px var(--space-xl);
    background-color: var(--color-brand);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast);
    margin-top: var(--space-sm);
  }

  .cart-drawer__cta-btn:hover,
  .cart-drawer__cta-btn:focus-visible {
    opacity: 0.9;
  }
</style>
