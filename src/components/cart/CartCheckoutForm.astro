---
import CheckoutNameField from './ui/CheckoutNameField.astro';
import CheckoutDeliverySection from './ui/CheckoutDeliverySection.astro';
import CheckoutPaymentSection from './ui/CheckoutPaymentSection.astro';
import CartDisclaimer from './ui/CartDisclaimer.astro';
---

<div class="cart-drawer__checkout">
  <CheckoutNameField />
  <CheckoutDeliverySection />
  <CheckoutPaymentSection />
  <CartDisclaimer />
</div>

<style>
  .cart-drawer__checkout {
    flex: 1;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    overflow-y: auto;
  }
</style>
