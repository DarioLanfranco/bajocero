---
import CartEmptyState from './ui/CartEmptyState.astro';
import CartDisclaimer from './ui/CartDisclaimer.astro';
---

<div id="cart-view" class="cart-drawer__view" data-cart-role="cart-view">
  <div id="cart-items" class="cart-drawer__items" data-cart-role="items">
    <CartEmptyState />
  </div>
  <CartDisclaimer />
</div>

<style>
  .cart-drawer__view {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__view[hidden] {
    display: none;
  }

  .cart-drawer__items {
    flex: 1;
    padding: 0 var(--space-lg);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
  }

  .cart-drawer__item-name {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .cart-drawer__item-weight {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .cart-drawer__item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
  }

  .cart-drawer__item-controls {
    display: flex;
    align-items: center;
    background-color: var(--color-surface-hover);
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-drawer__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .cart-drawer__qty-btn:hover,
  .cart-drawer__qty-btn:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .cart-drawer__qty-btn--increment {
    background-color: var(--color-brand);
    color: var(--color-text);
  }

  .cart-drawer__qty-btn--increment:hover,
  .cart-drawer__qty-btn--increment:focus-visible {
    opacity: 0.9;
  }

  .cart-drawer__qty-value {
    width: 32px;
    text-align: center;
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    user-select: none;
  }

  .cart-drawer__item-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .cart-drawer__item-total {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    line-height: 1;
  }

  .cart-drawer__item-unit {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    line-height: 1;
  }
</style>
