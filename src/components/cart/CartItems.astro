---
import { withBase } from '../../utils/format';
import Icon from '../ui/Icon.astro';
---

<div id="cart-view" class="cart-drawer__view" data-cart-role="cart-view">
  <div id="cart-items" class="cart-drawer__items" data-cart-role="items">
    <div id="cart-empty" class="cart-drawer__empty" data-cart-role="empty">
      <Icon name="cart" size={48} strokeWidth={1.5} />
      <p class="cart-drawer__empty-text">Tu carrito está vacío</p>
      <p class="cart-drawer__empty-sub">Agregá productos para comenzar tu pedido.</p>
      <a href={withBase('/productos')} class="cart-drawer__cta-btn">Explorar productos</a>
    </div>
  </div>
  <div class="cart-drawer__disclaimer" id="cart-disclaimer" data-cart-role="disclaimer" hidden>
    <svg class="cart-drawer__disclaimer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m16 16 3-8 3 8c-.3.7-1.1 1.3-1.6 2"/>
      <path d="M2 16 5 8l3 8c-.3.7-1.1 1.3-1.6 2"/>
      <path d="M7 21h10"/>
      <path d="M12 3v6"/>
      <path d="M6 8h12"/>
    </svg>
    <p class="cart-drawer__disclaimer-text">El precio final se ajusta en balanza al preparar el pedido. Puede variar levemente por gramos.</p>
  </div>
</div>

<style>
  .cart-drawer__view {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__view[hidden] {
    display: none;
  }

  .cart-drawer__items {
    flex: 1;
    padding: 0 var(--space-lg);
    display: flex;
    flex-direction: column;
  }

  #cart-empty[hidden] {
    display: none;
  }

  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: var(--space-md);
    padding: var(--space-2xl);
    text-align: center;
  }

  .cart-drawer__empty svg {
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-sm);
  }

  .cart-drawer__empty-text {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  .cart-drawer__empty-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 260px;
  }

  .cart-drawer__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px var(--space-xl);
    background-color: var(--color-brand);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast);
    margin-top: var(--space-sm);
  }

  .cart-drawer__cta-btn:hover,
  .cart-drawer__cta-btn:focus-visible {
    opacity: 0.9;
  }

  .cart-drawer__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
  }

  .cart-drawer__item-name {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .cart-drawer__item-weight {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .cart-drawer__item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
  }

  .cart-drawer__item-controls {
    display: flex;
    align-items: center;
    background-color: var(--color-surface-hover);
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-drawer__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .cart-drawer__qty-btn:hover,
  .cart-drawer__qty-btn:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .cart-drawer__qty-btn--increment {
    background-color: var(--color-brand);
    color: var(--color-text);
  }

  .cart-drawer__qty-btn--increment:hover,
  .cart-drawer__qty-btn--increment:focus-visible {
    opacity: 0.9;
  }

  .cart-drawer__qty-value {
    width: 32px;
    text-align: center;
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    user-select: none;
  }

  .cart-drawer__item-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .cart-drawer__item-total {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    line-height: 1;
  }

  .cart-drawer__item-unit {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    line-height: 1;
  }

  .cart-drawer__disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 var(--space-lg) var(--space-lg);
    padding: 12px 16px;
    background-color: rgba(24, 24, 27, 0.6);
    border: 1px solid rgba(39, 39, 42, 1);
    border-radius: 0.75rem;
  }

  .cart-drawer__disclaimer[hidden] {
    display: none;
  }

  .cart-drawer__disclaimer-icon {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex-shrink: 0;
    color: #FF7F11;
  }

  .cart-drawer__disclaimer-text {
    font-size: var(--font-size-xs);
    color: #a1a1aa;
    line-height: 1.6;
    font-weight: 400;
    margin: 0;
  }
</style>
