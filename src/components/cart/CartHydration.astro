---
import CartDrawer from './CartDrawer.astro';
import CartStickyBar from '../layout/CartStickyBar.astro';
---

<CartDrawer />
<CartStickyBar />

<script>
  import { createCartDrawer, initCartDrawerToggle } from '../../scripts/cartDrawer';
  import { getCartMediator } from '../../scripts/cartMediator';
  import { createCartBadge } from '../../scripts/cartBadge';
  import { createCartStickyBar } from '../../scripts/cartStickyBar';

  getCartMediator();
  createCartDrawer('cart-drawer');

  createCartBadge({
    cartBtnId: 'cart-btn',
    cartBadgeId: 'cart-badge',
    cartLabelSelector: '.cart-btn__label',
  });

  createCartStickyBar({
    barId: 'cart-sticky-bar',
    countId: 'cart-sticky-count',
    totalId: 'cart-sticky-total',
    btnSelector: '.cart-sticky-bar__btn',
  });

  initCartDrawerToggle();

  import('../../scripts/theme').then((m) => m.listenSystemThemeChanges()).catch(() => {});

  if (document.querySelector('.product-card')) {
    import('../../scripts/productCardErrorHandler').then((m) => m.initProductCardErrorHandler());
  }

  if (document.querySelector('[data-reveal]')) {
    import('../../scripts/reveal').catch(() => {});
  }

  if ('serviceWorker' in navigator) {
    const registerSW = () => {
      navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`)
        .then((reg) => { reg.onupdatefound = () => {}; })
        .catch(() => {});
    };
    const hasIdleCallback = 'requestIdleCallback' in window;
    if (hasIdleCallback) {
      window.requestIdleCallback(registerSW);
    } else {
      window.addEventListener('load', registerSW);
    }
  }
</script>
