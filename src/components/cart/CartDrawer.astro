---
import Drawer from '../ui/Drawer.astro';
import CartCheckoutForm from './CartCheckoutForm.astro';
import CartIcon from '../ui/CartIcon.astro';
import CartItems from './CartItems.astro';
import CartSummary from './CartSummary.astro';
---

<Drawer
  id="cart-drawer"
  panelWidth="460px"
  ariaLabel="Carrito de compras"
  closeBtnAriaLabel="Cerrar carrito"
>
  <h2 slot="header" class="cart-drawer__title">
    <CartIcon />
    Tu pedido
  </h2>

  <CartItems />

  <!-- Checkout view -->
  <div id="checkout-view" class="cart-drawer__view" data-cart-role="checkout-view" hidden>
    <CartCheckoutForm />
  </div>

  <!-- Cart actions footer -->
  <div slot="footer" id="cart-actions" class="cart-drawer__actions" data-cart-role="cart-actions">
    <CartSummary />

    <button
      id="cart-continue-btn"
      class="cart-drawer__continue-btn"
      type="button"
      data-cart-role="continue-btn"
    >
      Continuar con el pedido
    </button>

    <button
      id="cart-clear-btn"
      class="cart-drawer__clear-btn"
      type="button"
      data-cart-role="clear-btn"
    >
      Vaciar carrito
    </button>
  </div>

  <!-- Checkout actions footer -->
  <div slot="footer" id="checkout-actions" class="cart-drawer__actions" data-cart-role="checkout-actions" hidden>
    <button
      id="cart-send-btn"
      class="cart-drawer__send-btn"
      type="button"
      data-cart-role="send-btn"
    >
      Enviar Pedido a WhatsApp
    </button>

    <button
      id="cart-back-btn"
      class="cart-drawer__back-btn"
      type="button"
      data-cart-role="back-btn"
    >
      ← Volver al carrito
    </button>
  </div>
</Drawer>

<script>
  import { createCartDrawer } from '../../scripts/cartDrawer';

  createCartDrawer('cart-drawer');
</script>

<style>
  .cart-drawer__title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .cart-drawer__title svg {
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .cart-drawer__view {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__view[hidden] {
    display: none;
  }

  /* Footer */
  .cart-drawer__actions {
    flex-shrink: 0;
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cart-drawer__actions[hidden] {
    display: none;
  }

  /* Continue button (primary) */
  .cart-drawer__continue-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    background-color: var(--color-brand);
    color: var(--color-text);
    font-size: var(--font-size-base);
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    letter-spacing: 0.02em;
  }

  .cart-drawer__continue-btn:hover,
  .cart-drawer__continue-btn:focus-visible {
    opacity: 0.9;
  }

  .cart-drawer__continue-btn:active {
    transform: scale(0.98);
  }

  /* Clear button (text link) */
  .cart-drawer__clear-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 8px;
    background: none;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .cart-drawer__clear-btn:hover,
  .cart-drawer__clear-btn:focus-visible {
    color: var(--color-brand);
  }

  /* Send button */
  .cart-drawer__send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    background-color: var(--color-brand);
    color: var(--color-text);
    font-size: var(--font-size-base);
    font-weight: 700;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    letter-spacing: 0.02em;
  }

  .cart-drawer__send-btn:hover,
  .cart-drawer__send-btn:focus-visible {
    opacity: 0.9;
  }

  .cart-drawer__send-btn:active {
    transform: scale(0.98);
  }

  /* Back button */
  .cart-drawer__back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 8px;
    background: none;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .cart-drawer__back-btn:hover,
  .cart-drawer__back-btn:focus-visible {
    color: var(--color-brand);
  }
</style>
