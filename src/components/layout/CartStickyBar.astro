---
import Icon from '../ui/Icon.astro';
---

<div id="cart-sticky-bar" class="cart-sticky-bar" aria-label="Resumen del pedido">
  <button class="cart-sticky-bar__btn" type="button">
    <span class="cart-sticky-bar__icon" aria-hidden="true"><Icon name="cart" size={20} strokeWidth={2} /></span>
    <span class="cart-sticky-bar__text">Ver mi pedido <span id="cart-sticky-count">(0)</span></span>
    <span class="cart-sticky-bar__total" id="cart-sticky-total">— $0</span>
  </button>
</div>

<style>
  @import "../../styles/breakpoints.css";
  .cart-sticky-bar {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 40;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(18, 18, 18, 0.75);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  [data-theme="light"] .cart-sticky-bar {
    background: rgba(249, 246, 240, 0.85);
    border-color: rgba(18, 18, 18, 0.08);
  }

  .cart-sticky-bar.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .cart-sticky-bar__btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: 14px 20px;
    background-color: var(--color-brand);
    color: #fff;
    border: none;
    border-radius: 14px;
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    line-height: 1.2;
  }

  .cart-sticky-bar__btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) {
    .cart-sticky-bar__btn:hover {
      opacity: 0.92;
    }
  }

  .cart-sticky-bar__icon {
    flex-shrink: 0;
    font-size: var(--font-size-lg);
    line-height: 1;
  }

  .cart-sticky-bar__text {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-sticky-bar__total {
    flex-shrink: 0;
    font-size: var(--font-size-base);
    font-weight: 700;
  }

  @media (--bp-md-up) {
    .cart-sticky-bar {
      display: none;
    }
  }
</style>
