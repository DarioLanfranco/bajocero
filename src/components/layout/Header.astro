---
import { NAV_LINKS } from '../../data/navigation';
import { business } from '../../data/business';
import Drawer from '../ui/Drawer.astro';
import CartDrawer from '../cart/CartDrawer.astro';
import ThemeToggle from '../ThemeToggle.astro';
---

<header id="header" class="header" role="banner">
  <div class="header__inner container">
    <a href="/" class="header__logo" aria-label="Bajo Cero — Ir al inicio">
      {business.name}
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="header__nav-link">{link.label}</a>
      ))}
      <ThemeToggle />
    </nav>

    <div class="header__actions">
      <button
        id="hamburger-btn"
        class="header__hamburger"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>

      <button
        id="cart-btn"
        class="header__cart-btn"
        aria-label="Carrito de compras, vacío"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="header__cart-label">Carrito</span>
        <span id="cart-badge" class="header__cart-badge" aria-hidden="true">0</span>
      </button>
    </div>
  </div>
</header>

<Drawer
  id="mobile-drawer"
  panelWidth="300px"
  ariaLabel="Menú de navegación móvil"
  closeBtnAriaLabel="Cerrar menú"
>
  <span slot="header" class="drawer__logo">{business.name}</span>
  <nav class="drawer__nav" aria-label="Navegación móvil">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class="drawer__link">{link.label}</a>
    ))}
    <div class="drawer__theme">
      <ThemeToggle id="theme-toggle-drawer" />
      <span class="drawer__theme-label">Modo claro / oscuro</span>
    </div>
  </nav>
</Drawer>

<CartDrawer />

<style is:global>
  [data-drawer-open="true"] .header__hamburger-line:nth-child(1) {
    transform: translateY(8.5px) rotate(45deg);
  }
  [data-drawer-open="true"] .header__hamburger-line:nth-child(2) {
    opacity: 0;
  }
  [data-drawer-open="true"] .header__hamburger-line:nth-child(3) {
    transform: translateY(-8.5px) rotate(-45deg);
  }
</style>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: var(--z-header);
    height: var(--header-height-mobile);
    background-color: var(--color-bg-translucent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text);
    text-transform: uppercase;
    max-width: 45vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .header__logo:hover,
  .header__logo:focus-visible {
    opacity: 0.85;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: var(--space-xl);
  }

  .header__nav-link {
    position: relative;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
    transition: color var(--transition-fast);
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background-color: var(--color-coral);
    border-radius: 2px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-normal);
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible {
    color: var(--color-text);
  }

  .header__nav-link:hover::after,
  .header__nav-link:focus-visible::after {
    transform: translateX(-50%) scaleX(1);
    transform-origin: center;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
    flex-shrink: 0;
  }

  .header__hamburger:hover,
  .header__hamburger:focus-visible {
    background-color: var(--color-surface-hover);
  }

  .header__hamburger-line {
    display: block;
    width: 24px;
    height: 2.5px;
    background-color: var(--color-text);
    border-radius: 2px;
    transition: all var(--transition-normal);
    transform-origin: center;
  }

  .header__hamburger-line:nth-child(1),
  .header__hamburger-line:nth-child(3) {
    transform-origin: center;
  }

  .header__cart-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) 12px;
    background-color: var(--color-coral);
    color: var(--color-text);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    transition: opacity var(--transition-fast);
    position: relative;
    line-height: 1;
  }

  .header__cart-btn:hover,
  .header__cart-btn:focus-visible {
    opacity: 0.9;
  }

  .header__cart-btn:active {
    transform: scale(0.96);
  }

  .header__cart-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .header__cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    background-color: var(--color-text);
    color: var(--color-coral);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .drawer__logo {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .drawer__nav {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: var(--space-sm);
  }

  .drawer__link {
    display: flex;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
    border-radius: var(--radius-md);
    min-height: 48px;
    transition: background-color var(--transition-fast);
  }

  .drawer__link:hover,
  .drawer__link:focus-visible,
  .drawer__link:active {
    background-color: var(--color-surface-hover);
  }

  .drawer__theme {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    margin-top: auto;
  }

  .drawer__theme-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  @media (min-width: 1024px) {
    .header {
      height: var(--header-height);
    }

    .header__nav {
      display: flex;
    }

    .header__hamburger {
      display: none;
    }

    .header__cart-label {
      font-size: var(--font-size-sm);
    }
  }

  @media (max-width: 480px) {
    .header__cart-btn {
      padding: var(--space-sm) 10px;
    }

    .header__cart-label {
      display: none;
    }
  }
</style>

<script>
  import { createDrawer } from '../../scripts/drawer';
  import { createCartBadge } from '../../scripts/cartBadge';
  import { toggleCartDrawer } from '../../scripts/cartDrawer';

  createDrawer({
    drawerId: 'mobile-drawer',
    overlayId: 'mobile-drawer-overlay',
    panelId: 'mobile-drawer-panel',
    hamburgerId: 'hamburger-btn',
    closeId: 'mobile-drawer-close',
    linkSelector: '.drawer__link',
  });

  createCartBadge({
    cartBtnId: 'cart-btn',
    cartBadgeId: 'cart-badge',
    cartLabelSelector: '.header__cart-label',
  });

  const cartBtn = document.getElementById('cart-btn')!;
  cartBtn.addEventListener('click', toggleCartDrawer);
</script>
