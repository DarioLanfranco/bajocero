---
import { NAV_LINKS } from '../../data/navigation';
import { business } from '../../data/business';
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 w-full z-[100] h-[72px] lg:h-20 bg-bg-dark/92 backdrop-blur-lg border-b border-border"
>
  <div class="flex items-center justify-between h-full max-w-7xl mx-auto px-4 lg:px-6">
    <a
      href="/"
      class="font-heading text-xl lg:text-xl font-bold tracking-[0.15em] text-text-primary uppercase shrink-0 max-w-[45vw] truncate hover:opacity-85 transition-opacity"
      aria-label="Bajo Cero — Ir al inicio"
    >
      {business.name}
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="relative text-sm font-medium text-text-secondary tracking-wide
                 hover:text-text-primary transition-colors
                 after:content-[''] after:absolute after:left-0 after:bottom-[-2px]
                 after:h-0.5 after:w-0 after:bg-coral after:rounded-sm
                 after:transition-all after:duration-300
                 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <button
        id="hamburger-btn"
        class="flex lg:hidden flex-col justify-center items-center gap-[6px] w-11 h-11 p-2 rounded-lg
               hover:bg-surface-hover transition-colors shrink-0"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="h-line block w-6 h-[2.5px] bg-white rounded-sm transition-all duration-300 origin-center"></span>
        <span class="h-line block w-6 h-[2.5px] bg-white rounded-sm transition-all duration-300"></span>
        <span class="h-line block w-6 h-[2.5px] bg-white rounded-sm transition-all duration-300 origin-center"></span>
      </button>

      <button
        id="cart-btn"
        class="flex items-center gap-2 px-3 py-2 bg-coral text-text-primary rounded-lg text-sm
               font-semibold hover:opacity-90 transition-opacity active:scale-[0.96] relative"
        aria-label="Carrito de compras, vacío"
        type="button"
      >
        <svg
          class="shrink-0"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="text-xs lg:text-sm font-semibold">Carrito</span>
        <span
          id="cart-badge"
          class="absolute -top-1.5 -right-1.5 min-w-5 h-5 px-1.5 bg-text-primary text-coral
                 rounded-full text-[11px] font-bold shadow-md hidden items-center justify-center leading-none"
          aria-hidden="true"
        >0</span>
      </button>
    </div>
  </div>
</header>

<aside
  id="mobile-drawer"
  class="fixed inset-0 z-[200] overflow-x-hidden invisible pointer-events-none"
  aria-label="Menú de navegación móvil"
  role="dialog"
  aria-modal="true"
>
  <div
    id="drawer-overlay"
    class="absolute inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300"
  ></div>

  <div
    id="drawer-panel"
    class="absolute top-0 right-0 bottom-0 w-[300px] max-w-[85vw] bg-surface border-l border-border
           translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="flex items-center justify-between px-6 border-b border-border h-[72px] lg:h-20 shrink-0">
      <span class="font-heading text-lg font-bold tracking-[0.15em] text-text-primary uppercase">
        {business.name}
      </span>
      <button
        id="drawer-close-btn"
        class="flex items-center justify-center min-w-11 min-h-11 rounded-lg text-text-primary
               hover:bg-surface-hover transition-colors"
        aria-label="Cerrar menú"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col p-4 gap-2" aria-label="Navegación móvil">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="drawer-link flex items-center px-6 py-4 text-xl font-semibold text-text-primary
                 rounded-lg hover:bg-surface-hover active:bg-surface-hover transition-colors min-h-12"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</aside>

<style is:global>
  [data-drawer-open="true"] .h-line:nth-child(1) {
    transform: translateY(8.5px) rotate(45deg);
  }
  [data-drawer-open="true"] .h-line:nth-child(2) {
    opacity: 0;
  }
  [data-drawer-open="true"] .h-line:nth-child(3) {
    transform: translateY(-8.5px) rotate(-45deg);
  }
</style>

<script>
  import { cartStore } from '../../store/cart';

  (function () {
    'use strict';

    const drawer = document.getElementById('mobile-drawer')!;
    const overlay = document.getElementById('drawer-overlay')!;
    const panel = document.getElementById('drawer-panel')!;
    const hamburgerBtn = document.getElementById('hamburger-btn') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('drawer-close-btn')!;
    const cartBtn = document.getElementById('cart-btn')!;
    const cartBadge = document.getElementById('cart-badge')!;

    const linkEls = drawer.querySelectorAll<HTMLAnchorElement>('.drawer-link');
    let focusableElements: HTMLElement[] = [];
    let firstFocusable: HTMLElement | null = null;
    let lastFocusable: HTMLElement | null = null;
    let isOpen = false;

    function updateFocusable(): void {
      const all = drawer.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const filtered = Array.from(all).filter(function (el) {
        return el.offsetParent !== null || el === closeBtn;
      });
      focusableElements = filtered.length > 0 ? filtered : Array.from(all);
      firstFocusable = focusableElements[0] ?? null;
      lastFocusable = focusableElements[focusableElements.length - 1] ?? null;
    }

    function openDrawerUI(): void {
      isOpen = true;
      drawer.classList.remove('invisible', 'pointer-events-none');
      requestAnimationFrame(function () {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        panel.classList.remove('translate-x-full');
      });
      document.documentElement.setAttribute('data-drawer-open', 'true');
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      document.body.style.top = '0';
      document.body.style.left = '0';
      if (hamburgerBtn) {
        hamburgerBtn.setAttribute('aria-expanded', 'true');
        hamburgerBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      }
      updateFocusable();
      if (firstFocusable) firstFocusable.focus();
      document.addEventListener('keydown', handleKeydown);
    }

    function closeDrawerUI(): void {
      isOpen = false;
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
      document.documentElement.removeAttribute('data-drawer-open');
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.top = '';
      document.body.style.left = '';
      if (hamburgerBtn) {
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        hamburgerBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      }
      document.removeEventListener('keydown', handleKeydown);
      setTimeout(function () {
        drawer.classList.add('invisible', 'pointer-events-none');
      }, 300);
    }

    function handleKeydown(e: KeyboardEvent): void {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDrawerUI();
        if (hamburgerBtn) hamburgerBtn.focus();
        return;
      }
      if (e.key === 'Tab') {
        updateFocusable();
        if (!firstFocusable || !lastFocusable) return;
        if (e.shiftKey && document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable.focus();
        } else if (!e.shiftKey && document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable.focus();
        }
      }
    }

    function updateCartBadge(): void {
      const items = cartStore.items;
      let count = 0;
      for (let i = 0; i < items.length; i++) {
        count += items[i].quantity;
      }
      if (count > 0) {
        cartBadge.textContent = String(count);
        cartBadge.classList.remove('hidden');
        cartBadge.classList.add('flex');
      } else {
        cartBadge.classList.add('hidden');
        cartBadge.classList.remove('flex');
      }
      const label = 'Carrito de compras' + (count > 0 ? ', ' + count + ' artículos' : ', vacío');
      cartBtn.setAttribute('aria-label', label);
    }

    if (hamburgerBtn) {
      hamburgerBtn.addEventListener('click', function () {
        if (isOpen) {
          closeDrawerUI();
          hamburgerBtn.focus();
        } else {
          openDrawerUI();
        }
      });
    }

    closeBtn.addEventListener('click', function () {
      closeDrawerUI();
      if (hamburgerBtn) hamburgerBtn.focus();
    });

    overlay.addEventListener('click', function () {
      closeDrawerUI();
      if (hamburgerBtn) hamburgerBtn.focus();
    });

    for (let i = 0; i < linkEls.length; i++) {
      linkEls[i].addEventListener('click', function () {
        closeDrawerUI();
      });
    }

    cartStore.subscribe(function () {
      updateCartBadge();
    });

    updateCartBadge();
  })();
</script>
