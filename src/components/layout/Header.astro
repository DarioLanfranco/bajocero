---
import { withBase } from '../../utils/format';
import Logo from '../ui/Logo.astro';
import CartButton from '../ui/CartButton.astro';
import CartDrawer from '../cart/CartDrawer.astro';
import HeaderNav from './HeaderNav.astro';
import MobileDrawer from './MobileDrawer.astro';
import CartStickyBar from './CartStickyBar.astro';
---

<header id="header" class="header" role="banner">
  <div class="header__inner container">
    <a href={withBase('/')} class="header__logo-link" aria-label="Bajo Cero — Ir al inicio">
      <Logo />
    </a>

    <HeaderNav />

    <div class="header__actions">
      <button
        id="hamburger-btn"
        class="header__hamburger"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>

      <CartButton />
    </div>
  </div>
</header>

<MobileDrawer />

<CartDrawer />

<CartStickyBar />

<style is:global>
  [data-drawer-open="true"] .header__hamburger-line:nth-child(1) {
    transform: translateY(8.5px) rotate(45deg);
  }
  [data-drawer-open="true"] .header__hamburger-line:nth-child(2) {
    opacity: 0;
  }
  [data-drawer-open="true"] .header__hamburger-line:nth-child(3) {
    transform: translateY(-8.5px) rotate(-45deg);
  }
</style>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: var(--z-header);
    height: var(--header-height-mobile);
    background-color: var(--color-bg-translucent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    max-width: 45vw;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .header__logo-link:hover,
  .header__logo-link:focus-visible {
    opacity: 0.85;
  }

  :global(.header__nav) {
    display: none;
    align-items: center;
    gap: var(--space-xl);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
    flex-shrink: 0;
  }

  .header__hamburger:hover,
  .header__hamburger:focus-visible {
    background-color: var(--color-surface-hover);
  }

  .header__hamburger-line {
    display: block;
    width: 24px;
    height: 2.5px;
    background-color: var(--color-text);
    border-radius: 2px;
    transition: all var(--transition-normal);
    transform-origin: center;
  }

  .header__hamburger-line:nth-child(1),
  .header__hamburger-line:nth-child(3) {
    transform-origin: center;
  }

  @media (min-width: 1024px) {
    .header {
      height: var(--header-height);
    }

    :global(.header__nav) {
      display: flex;
    }

    .header__hamburger {
      display: none;
    }
  }
</style>

<script>
  import { createDrawer } from '../../scripts/drawer';
  import { createCartBadge } from '../../scripts/cartBadge';
  import { createCartStickyBar } from '../../scripts/cartStickyBar';
  import { initCartDrawerToggle } from '../../scripts/cartDrawer';

  createDrawer({
    drawerId: 'mobile-drawer',
    overlayId: 'mobile-drawer-overlay',
    panelId: 'mobile-drawer-panel',
    hamburgerId: 'hamburger-btn',
    closeId: 'mobile-drawer-close',
    linkSelector: '.drawer__link',
  });

  createCartBadge({
    cartBtnId: 'cart-btn',
    cartBadgeId: 'cart-badge',
    cartLabelSelector: '.cart-btn__label',
  });

  createCartStickyBar({
    barId: 'cart-sticky-bar',
    countId: 'cart-sticky-count',
    totalId: 'cart-sticky-total',
    btnSelector: '.cart-sticky-bar__btn',
  });

  initCartDrawerToggle();
</script>
