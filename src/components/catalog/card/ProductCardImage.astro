---
import type { Product } from '../../../types/Product';
import { generateSrcSet, transformImageUrl, DEFAULT_IMAGE_SIZES } from '../../../utils/images';
import ProductCardBadge from './ProductCardBadge.astro';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, imageUrl, isAvailable, isFresh, offerLabel } = product;
const hasOffer = !!offerLabel;
---

<div class="product-card__image-wrap">
  {imageUrl ? (
    <img
      class="product-card__image"
      src={transformImageUrl(imageUrl, { width: 400 })}
      alt={name}
      width="4"
      height="3"
      srcset={generateSrcSet(imageUrl) || undefined}
      sizes={DEFAULT_IMAGE_SIZES}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="product-card__image-fallback" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <circle cx="8.5" cy="8.5" r="1.5"/>
        <polyline points="21 15 16 10 5 21"/>
      </svg>
    </div>
  )}

  {(hasOffer || !isAvailable || isFresh) && (
    <div class="product-card__badges">
      {!isAvailable && <ProductCardBadge type="agotado" />}
      {hasOffer && <ProductCardBadge type="offer" label={offerLabel} />}
      {isFresh && <ProductCardBadge type="fresh" />}
    </div>
  )}
</div>

<style>
  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .product-card__image-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(var(--color-brand-rgb), 0.05);
    border: 2px dashed rgba(var(--color-brand-rgb), 0.2);
    margin: 8px;
    border-radius: 12px;
  }

  @media (hover: hover) {
    .product-card:hover .product-card__image {
      transform: scale(1.04);
      will-change: transform;
    }
  }

  .product-card__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
</style>
