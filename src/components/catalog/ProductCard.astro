---
import type { Product } from '../../types/Product';
import ProductCardImage from './card/ProductCardImage.astro';
import ProductCardPricing from './card/ProductCardPricing.astro';
import ProductCardActions from './card/ProductCardActions.astro';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const { id, name, presentacion, description, isAvailable, tipoVenta } = product;
const cantidadPorKg = product.cantidadPorKg;
const rindeUnidades = cantidadPorKg && cantidadPorKg > 0 ? Math.round(cantidadPorKg / 2) : null;
---

<article
  class="product-card"
  data-product-id={id}
  data-product-name={name}
  data-product-price={product.price}
  data-product-presentacion={presentacion || ''}
  data-product-tipo-venta={tipoVenta}
  data-product-available={isAvailable}
>
  <ProductCardImage product={product} />

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>

    {presentacion && tipoVenta !== 'pack' && (
      <span class="product-card__presentacion">{presentacion}</span>
    )}
    {rindeUnidades && (
      <span class="product-card__rinde">Rinde aprox. {rindeUnidades} u.</span>
    )}

    {description && (
      <p class="product-card__description">{description}</p>
    )}

    <div class="product-card__footer">
      <ProductCardPricing product={product} />
      <ProductCardActions product={product} />
    </div>
  </div>
</article>

<style>
  @import "../../styles/breakpoints.css";
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid rgba(var(--color-brand-rgb), 0.2);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  @media (hover: hover) {
    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
    }
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: 6px;
  }

  .product-card__name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .product-card__presentacion {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-brand);
    letter-spacing: 0.02em;
  }

  .product-card__rinde {
    font-size: 11px;
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }

  .product-card__description {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 12px;
  }
</style>
