---
import type { Product } from '../../types/Product';
import { formatPrice } from '../../utils/format';
import { generateSrcSet, DEFAULT_IMAGE_SIZES } from '../../utils/images';
import PlusIcon from '../ui/icons/PlusIcon.astro';
import MinusIcon from '../ui/icons/MinusIcon.astro';

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const { id, name, description, price, offerLabel, isFresh, isAvailable, presentacion, imageUrl, cantidadPorKg } = product;
const src = imageUrl || '';
const hasPrice = price > 0;
const hasOffer = !!offerLabel;
const rindeUnidades = cantidadPorKg && cantidadPorKg > 0 ? Math.round(cantidadPorKg / 2) : null;
---

<article
  class="product-card"
  data-product-id={id}
  data-product-name={name}
  data-product-price={price}
  data-product-presentacion={presentacion || ''}
>
  <div class="product-card__image-wrap">
    <img
      class="product-card__image"
      src={src}
      alt={name}
      width="4"
      height="3"
      srcset={generateSrcSet(src) || undefined}
      sizes={DEFAULT_IMAGE_SIZES}
      loading="lazy"
      decoding="async"
    />

    {(hasOffer || !isAvailable || isFresh) && (
      <div class="product-card__badges">
        {!isAvailable && (
          <span class="product-card__badge product-card__badge--agotado">Agotado</span>
        )}
        {hasOffer && (
          <span class="product-card__badge product-card__badge--offer">{offerLabel}</span>
        )}
        {isFresh && (
          <span class="product-card__badge product-card__badge--fresh">Fresco hoy</span>
        )}
      </div>
    )}
  </div>

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>

    {presentacion && (
      <span class="product-card__presentacion">{presentacion}</span>
    )}
    {rindeUnidades && (
      <span class="product-card__rinde">Rinde aprox. {rindeUnidades} u.</span>
    )}

    {description && (
      <p class="product-card__description">{description}</p>
    )}

    <div class="product-card__footer">
      <div class="product-card__pricing">
        {hasPrice ? (
          <span class="product-card__price">{formatPrice(price)}</span>
        ) : (
          <span class="product-card__price product-card__price--consult">Consultar</span>
        )}
      </div>

      <button
        class="product-card__add-btn"
        data-action="add"
        aria-label={`Agregar ${name} al carrito`}
        type="button"
        disabled={!isAvailable || !hasPrice}
      >
        <PlusIcon size={22} />
      </button>

      <div class="product-card__qty" hidden>
        <button
          class="product-card__qty-btn"
          data-action="decrement"
          aria-label={`Disminuir cantidad de ${name}`}
          type="button"
        >
          <MinusIcon size={18} />
        </button>
        <span class="product-card__qty-value" data-qty-value aria-live="polite">0</span>
        <button
          class="product-card__qty-btn product-card__qty-btn--increment"
          data-action="increment"
          aria-label={`Aumentar cantidad de ${name}`}
          type="button"
        >
          <PlusIcon size={18} />
        </button>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid rgba(var(--color-brand-rgb), 0.2);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  @media (hover: hover) {
    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card-hover);
    }
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
    will-change: transform;
  }

  @media (hover: hover) {
    .product-card:hover .product-card__image {
      transform: scale(1.04);
    }
  }

  .product-card__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .product-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    font-size: var(--font-size-xs);
    font-weight: 700;
    border-radius: var(--radius-full);
    line-height: 1;
  }

  .product-card__badge--offer {
    background-color: var(--color-brand);
    color: var(--color-text);
  }

  .product-card__badge--agotado {
    background-color: var(--color-text-tertiary);
    color: var(--color-bg);
  }

  .product-card__badge--fresh {
    background-color: var(--color-brand);
    color: var(--color-bg);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: 6px;
  }

  .product-card__name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .product-card__presentacion {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-brand);
    letter-spacing: 0.02em;
  }

  .product-card__rinde {
    font-size: 11px;
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }

  .product-card__description {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 12px;
  }

  .product-card__pricing {
    display: flex;
    flex-direction: column;
  }

  .product-card__price {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    transition: color 0.3s ease;
  }

  .product-card:has(.product-card__qty:not([hidden])) .product-card__price {
    color: var(--color-brand);
  }

  .product-card__price--offer {
    color: var(--color-brand);
  }

  .product-card__price--old {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-decoration: line-through;
  }

  .product-card__price--consult {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .product-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-brand);
    color: var(--color-text);
    border-radius: 12px;
    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast),
      box-shadow var(--transition-fast);
    flex-shrink: 0;
  }

  @media (hover: hover) {
    .product-card__add-btn:hover,
    .product-card__add-btn:focus-visible {
      transform: scale(1.08);
      opacity: 1;
      box-shadow: 0 4px 16px rgba(var(--color-brand-rgb), 0.35);
    }
  }

  .product-card__add-btn:active {
    transform: scale(0.92);
    transition-duration: 80ms;
  }

  .product-card__add-btn[hidden] {
    display: none;
  }

  .product-card__add-btn[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .product-card__qty {
    display: flex;
    align-items: center;
    background-color: var(--color-surface-hover);
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .product-card__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .product-card__qty-btn:hover,
  .product-card__qty-btn:focus-visible {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .product-card__qty-btn--increment {
    background-color: var(--color-brand);
    color: var(--color-text);
  }

  .product-card__qty-btn--increment:hover,
  .product-card__qty-btn--increment:focus-visible {
    opacity: 0.9;
  }

  .product-card__qty-value {
    width: 32px;
    text-align: center;
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
    user-select: none;
  }

  .product-card__qty[hidden] {
    display: none;
  }
</style>

<style is:global>
  .product-card__image-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(var(--color-brand-rgb), 0.05);
    border: 2px dashed rgba(var(--color-brand-rgb), 0.2);
    margin: 8px;
    border-radius: 12px;
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
</style>
