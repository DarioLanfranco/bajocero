---
import type { Product } from '../../types/Product';

export interface Props {
  product: Product;
  imageSrc: string;
  quantity?: number;
}

const { product, imageSrc, quantity = 0 } = Astro.props;
const { name, description, price, isOffer, offerPrice, isFresh } = product;
---

<article class="relative flex flex-col bg-surface border border-border-mint rounded-2xl overflow-hidden">
  <div class="relative aspect-[4/3] overflow-hidden bg-bg-dark">
    <img
      class="absolute inset-0 w-full h-full object-cover"
      src={imageSrc}
      alt={name}
      loading="lazy"
      decoding="async"
    />

    {(isOffer || isFresh) && (
      <div class="absolute top-3 left-3 flex flex-col gap-2">
        {isOffer && (
          <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold bg-coral text-white rounded-full">
            Oferta
          </span>
        )}
        {isFresh && (
          <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold bg-mint text-bg-dark rounded-full">
            Fresco hoy
          </span>
        )}
      </div>
    )}
  </div>

  <div class="flex flex-col flex-1 p-4 gap-1.5">
    <h3 class="text-sm font-semibold text-text-primary leading-tight">
      {name}
    </h3>

    <p class="text-xs text-text-secondary leading-relaxed line-clamp-2">
      {description}
    </p>

    <div class="mt-auto flex items-end justify-between pt-3">
      <div class="flex flex-col">
        {isOffer && offerPrice ? (
          <>
            <span class="text-xs text-text-tertiary line-through">${price.toLocaleString('es-AR')}</span>
            <span class="text-lg font-bold text-coral">${offerPrice.toLocaleString('es-AR')}</span>
          </>
        ) : (
          <span class="text-lg font-bold text-text-primary">${price.toLocaleString('es-AR')}</span>
        )}
      </div>

      {quantity > 0 ? (
        <div class="flex items-center bg-surface-hover rounded-xl overflow-hidden">
          <button
            class="flex items-center justify-center w-10 h-10 text-text-secondary hover:text-text-primary transition-colors"
            aria-label={`Disminuir cantidad de ${name}`}
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>

          <span class="w-8 text-center text-sm font-bold text-text-primary select-none" aria-live="polite">
            {quantity}
          </span>

          <button
            class="flex items-center justify-center w-10 h-10 bg-coral text-white transition-opacity hover:opacity-90"
            aria-label={`Aumentar cantidad de ${name}`}
            type="button"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
        </div>
      ) : (
        <button
          class="flex items-center justify-center w-12 h-12 bg-coral text-white rounded-xl transition-opacity hover:opacity-90"
          aria-label={`Agregar ${name} al carrito`}
          type="button"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>
      )}
    </div>
  </div>
</article>
