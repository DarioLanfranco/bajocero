---
import type { Product } from '../../types/Product';

export interface Props {
  product: Product;
  imageSrc: string;
}

const { product, imageSrc } = Astro.props;
const { name, description, price, isOffer, offerPrice, isFresh } = product;
---

<article class="product-card">
  <div class="product-card__image-wrap">
    <img
      class="product-card__image"
      src={imageSrc}
      alt={name}
      loading="lazy"
      decoding="async"
    />

    {(isOffer || isFresh) && (
      <div class="product-card__badges">
        {isOffer && (
          <span class="product-card__badge product-card__badge--offer">Oferta</span>
        )}
        {isFresh && (
          <span class="product-card__badge product-card__badge--fresh">Fresco hoy</span>
        )}
      </div>
    )}
  </div>

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>

    <p class="product-card__description">{description}</p>

    <div class="product-card__footer">
      <div class="product-card__pricing">
        {isOffer && offerPrice ? (
          <>
            <span class="product-card__price--old">${price.toLocaleString('es-AR')}</span>
            <span class="product-card__price product-card__price--offer">${offerPrice.toLocaleString('es-AR')}</span>
          </>
        ) : (
          <span class="product-card__price">${price.toLocaleString('es-AR')}</span>
        )}
      </div>

      <button
        class="product-card__add-btn"
        aria-label={`Agregar ${name} al carrito`}
        type="button"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </button>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid rgba(0, 191, 166, 0.2);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.03);
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .product-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    font-size: var(--font-size-xs);
    font-weight: 700;
    border-radius: var(--radius-full);
    line-height: 1;
  }

  .product-card__badge--offer {
    background-color: var(--color-coral);
    color: var(--color-text);
  }

  .product-card__badge--fresh {
    background-color: var(--color-mint);
    color: var(--color-bg);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    gap: 6px;
  }

  .product-card__name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .product-card__description {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 12px;
  }

  .product-card__pricing {
    display: flex;
    flex-direction: column;
  }

  .product-card__price {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .product-card__price--offer {
    color: var(--color-coral);
  }

  .product-card__price--old {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    text-decoration: line-through;
  }

  .product-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-coral);
    color: var(--color-text);
    border-radius: 12px;
    transition: opacity var(--transition-fast);
    flex-shrink: 0;
  }

  .product-card__add-btn:hover,
  .product-card__add-btn:focus-visible {
    opacity: 0.9;
  }
</style>
