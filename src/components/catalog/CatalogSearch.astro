---
import Icon from '../ui/Icon.astro';
---

<div class="catalog-page__search">
  <div class="catalog-page__search-icon" aria-hidden="true">
    <Icon name="search" size={18} strokeWidth={2} />
  </div>
  <input
    class="catalog-page__search-input"
    type="text"
    placeholder="Buscar producto..."
    aria-label="Buscar productos por nombre o descripción"
    autocomplete="off"
    spellcheck="false"
    data-catalog-role="search-input"
  />
  <span class="catalog-page__search-count">
    <span data-catalog-role="count">0</span> productos
  </span>
</div>

<style>
  .catalog-page__search {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 16px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2xl);
  }

  .catalog-page__search:focus-within {
    border-color: var(--color-brand);
  }

  .catalog-page__search-icon {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }

  .catalog-page__search-input {
    flex: 1;
    font-size: var(--font-size-base);
    color: var(--color-text);
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    line-height: 1.5;
  }

  .catalog-page__search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .catalog-page__search-count {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
