---
import type { FAQItem } from '../data/faq';
import SectionHeading from './ui/SectionHeading.astro';

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="faq" id="faq" aria-label="Preguntas frecuentes" data-reveal>
  <div class="faq__container container">
    <div class="faq__header" data-reveal data-reveal-delay="50">
      <SectionHeading
        eyebrow="FAQ"
        titleStart="Preguntas"
        titleAccent="frecuentes"
      />
    </div>

    <div class="faq__list" data-reveal data-reveal-delay="100">
      {items.map((item) => (
        <details class="faq__item" name="faq">
          <summary class="faq__question">{item.question}</summary>
          <div class="faq__answer">
            <div class="faq__answer-inner">
              <p>{item.answer}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  @import "../styles/breakpoints.css";
  .faq {
    padding: var(--space-3xl) 0;
  }

  .faq__header {
    margin-bottom: var(--space-2xl);
  }

  .faq__list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .faq__question {
    position: relative;
    list-style: none;
    padding: var(--space-lg) var(--space-2xl) var(--space-lg) 0;
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition: color var(--transition-fast);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-brand);
    font-size: var(--font-size-xl);
    font-weight: 300;
    line-height: 1;
    transition: transform var(--transition-normal);
  }

  details[open] .faq__question::after {
    content: '\2212';
  }

  .faq__question:hover {
    color: var(--color-brand);
  }

  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-normal) var(--easing-smooth);
  }

  details[open] .faq__answer {
    grid-template-rows: 1fr;
  }

  .faq__answer-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq__answer-inner p {
    padding: 0 0 var(--space-lg);
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  @media (--bp-md-up) {
    .faq__question {
      font-size: var(--font-size-xl);
      padding: var(--space-xl) var(--space-2xl) var(--space-xl) 0;
    }
  }
</style>
