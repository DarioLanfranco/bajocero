---
const YEAR = new Date().getFullYear();
let holidays: Array<{ mes: number; dia: number; motivo: string }> = [];
try {
  const res = await fetch(`https://nolaborables.com.ar/api/v1/${YEAR}`);
  if (res.ok) holidays = await res.json();
} catch (_) {
  /* fallback: empty holidays */
}
const holidaysJson = JSON.stringify(holidays);
---

<div class="status-badge" id="status-badge" data-reveal role="status" aria-live="polite" data-holidays={holidaysJson}>
  <span class="status-badge__dot" aria-hidden="true"></span>
  <span class="status-badge__text">Cargando…</span>
</div>

<script>
  (() => {
    const BADGE_ID = 'status-badge';
    const badge = document.getElementById(BADGE_ID);
    if (!badge) return;

    const dot = badge.querySelector('.status-badge__dot');
    const textEl = badge.querySelector('.status-badge__text');
    if (!dot || !textEl) return;

    const TZ = 'America/Argentina/Cordoba';
    const MORNING_OPEN = 9 * 60;
    const MORNING_CLOSE = 14 * 60;
    const AFTERNOON_OPEN = 16 * 60;
    const AFTERNOON_CLOSE = 20 * 60 + 30;

    let holidays: { mes: number; dia: number; motivo: string }[] = [];
    const raw = badge.getAttribute('data-holidays');
    if (raw) {
      try { holidays = JSON.parse(raw); } catch (_) {}
    }

    const now = new Date();
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: TZ,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(now);

    const get = (t: string): number => {
      const found = parts.find((p) => p.type === t);
      return found ? parseInt(found.value, 10) : 0;
    };
    const month = get('month');
    const day = get('day');
    const hour = get('hour');
    const minute = get('minute');

    const weekdayStr = new Intl.DateTimeFormat('en-US', {
      timeZone: TZ,
      weekday: 'short',
    }).format(now);
    const DAY_MAP: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    const weekday = DAY_MAP[weekdayStr] ?? 0;

    const totalMin = hour * 60 + minute;
    const isHoliday = holidays.some((h) => h.mes === month && h.dia === day);

    let isOpen: boolean;
    let text: string;

    if (isHoliday) {
      const h = holidays.find((h) => h.mes === month && h.dia === day);
      isOpen = false;
      text = h ? `Cerrado por Feriado | ${h.motivo}` : 'Cerrado por Feriado';
    } else if (weekday === 0 || weekday === 6) {
      isOpen = false;
      text = 'Cerrado | Abrimos el lunes a las 09:00';
    } else if (totalMin >= MORNING_OPEN && totalMin < MORNING_CLOSE) {
      isOpen = true;
      text = 'Abierto ahora | Cierra a las 14:00';
    } else if (totalMin >= AFTERNOON_OPEN && totalMin < AFTERNOON_CLOSE) {
      isOpen = true;
      text = 'Abierto ahora | Cierra a las 20:30';
    } else if (totalMin >= MORNING_CLOSE && totalMin < AFTERNOON_OPEN) {
      isOpen = false;
      text = 'Cerrado | Abrimos hoy a las 16:00';
    } else if (totalMin < MORNING_OPEN) {
      isOpen = false;
      text = 'Cerrado | Abrimos hoy a las 09:00';
    } else if (weekday === 5) {
      isOpen = false;
      text = 'Cerrado | Abrimos el lunes a las 09:00';
    } else {
      isOpen = false;
      text = 'Cerrado | Abrimos mañana a las 09:00';
    }

    badge.classList.add(isOpen ? 'status-badge--open' : 'status-badge--closed');
    textEl.textContent = text;
  })();
</script>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px 16px;
    border: 1px solid;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    margin-bottom: var(--space-xl);
    transition:
      border-color var(--transition-normal),
      background-color var(--transition-normal);
  }

  .status-badge--open {
    border-color: rgba(var(--color-brand-rgb), 0.4);
    background-color: rgba(var(--color-brand-rgb), 0.08);
    color: var(--color-brand);
  }

  .status-badge--closed {
    border-color: rgba(239, 68, 68, 0.3);
    background-color: rgba(127, 29, 29, 0.15);
    color: #f87171;
  }

  .status-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background-color var(--transition-normal);
  }

  .status-badge--open .status-badge__dot {
    background-color: var(--color-brand);
    animation: pulse 2s ease-in-out infinite;
  }

  .status-badge--closed .status-badge__dot {
    background-color: #ef4444;
    animation: pulse-closed 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(var(--color-brand-rgb), 0.35);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(var(--color-brand-rgb), 0);
    }
  }

  @keyframes pulse-closed {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-badge--open .status-badge__dot,
    .status-badge--closed .status-badge__dot {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .status-badge {
      font-size: var(--font-size-xs);
      padding: 4px 12px;
    }
  }
</style>
