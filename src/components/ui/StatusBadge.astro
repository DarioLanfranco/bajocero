---
import { getHolidays } from '../../data/holidays';
const holidaysJson = JSON.stringify(getHolidays());
---

<div class="status-badge" id="status-badge" data-reveal data-holidays={holidaysJson} role="status" aria-live="polite">
  <span class="status-badge__dot" aria-hidden="true"></span>
  <span class="status-badge__text"></span>
</div>

<script>
  import('../../scripts/statusBadge').then((m) => m.initStatusBadge()).catch(() => {});
</script>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px 16px;
    border: 1px solid;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    margin-bottom: var(--space-xl);
    transition:
      border-color var(--transition-normal),
      background-color var(--transition-normal);
  }

  .status-badge--open {
    border-color: rgba(0, 200, 83, 0.4);
    background-color: rgba(0, 200, 83, 0.08);
    color: #00C853;
  }

  .status-badge--closed {
    border-color: rgba(239, 68, 68, 0.3);
    background-color: rgba(127, 29, 29, 0.15);
    color: #f87171;
  }

  .status-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background-color var(--transition-normal);
  }

  .status-badge--open .status-badge__dot {
    background-color: #00C853;
    box-shadow: 0 0 6px rgba(0, 200, 83, 0.4);
    animation: pulse-opacity 2s ease-in-out infinite;
  }

  .status-badge--closed .status-badge__dot {
    background-color: #ef4444;
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.4);
    animation: pulse-opacity 2s ease-in-out infinite;
  }

  @keyframes pulse-opacity {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-badge--open .status-badge__dot,
    .status-badge--closed .status-badge__dot {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .status-badge {
      font-size: var(--font-size-xs);
      padding: 4px 12px;
    }
  }
</style>
