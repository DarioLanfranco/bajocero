---

---

<template id="ideal-result-ok">
  <div class="ideal__combo ideal__combo--enter">
    <div class="ideal__combo-items" data-part="items"></div>
    <div class="ideal__combo-total">
      <span class="ideal__combo-total-label">Total a pagar</span>
      <span class="ideal__combo-total-value" data-part="total"></span>
    </div>
    <p class="ideal__combo-remaining" data-part="remaining"></p>
    <button class="ideal__combo-btn" data-part="add-btn">Agregar Combo al Carrito</button>
  </div>
</template>

<template id="ideal-result-empty">
  <div class="ideal__empty">
    <p class="ideal__empty-text">No encontramos un combo con esos filtros. Probá cambiando el presupuesto o la cantidad de comensales.</p>
  </div>
</template>

<template id="ideal-result-item">
  <div class="ideal__combo-item">
    <div class="ideal__combo-item-info">
      <span class="ideal__combo-item-name" data-part="name"></span>
      <span class="ideal__combo-item-detail" data-part="detail"></span>
    </div>
    <span class="ideal__combo-item-price" data-part="price"></span>
  </div>
</template>

<style>
  .ideal__combo {
    width: 100%;
    max-width: 500px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .ideal__combo--enter {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .ideal__combo--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ideal__combo-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ideal__combo-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .ideal__combo-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ideal__combo-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .ideal__combo-item-name {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .ideal__combo-item-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }

  .ideal__combo-item-price {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ideal__combo-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .ideal__combo-total-label {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .ideal__combo-total-value {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-brand);
  }

  .ideal__combo-remaining {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-align: center;
    line-height: 1.4;
  }

  .ideal__combo-remaining--hidden {
    display: none;
  }

  .ideal__combo-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 18px var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-brand);
    border: none;
    border-radius: 14px;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    line-height: 1.2;
    cursor: pointer;
    min-height: 56px;
  }

  .ideal__combo-btn:hover {
    opacity: 0.9;
  }

  .ideal__combo-btn:active {
    transform: scale(0.97);
  }

  .ideal__combo-btn--done {
    background: #22c55e;
    pointer-events: none;
  }

  .ideal__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
  }

  .ideal__empty-text {
    font-size: var(--font-size-base);
    color: var(--color-text-tertiary);
    line-height: 1.6;
    max-width: 380px;
  }
</style>
