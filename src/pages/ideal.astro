---
import Layout from '../layouts/Layout.astro';
import CartHydration from '../components/cart/CartHydration.astro';
import IdealFilters from '../components/ideal/IdealFilters.astro';
import IdealResultArea from '../components/ideal/IdealResultArea.astro';
import CatalogDataScript from '../components/catalog/CatalogDataScript.astro';
import { loadCatalogProducts } from '../data/catalogLoader';
import type { Product } from '../types/Product';

const products: Product[] = await loadCatalogProducts();
---

<Layout
  title="Tu Pedido Ideal — Bajo Cero"
  description="Respondé dos preguntas y te armamos el combo perfecto de productos congelados."
>
  <CatalogDataScript products={products} />
  <div id="ideal-container">
  <section class="ideal">
    <div class="container">
      <header class="ideal__header">
        <h1 class="ideal__title">Tu Pedido Ideal</h1>
        <p class="ideal__subtitle">
          Elegí cuánto querés gastar o cuántos son para comer, y te armamos el combo perfecto en un clic.
        </p>
      </header>

      <IdealFilters />

      <div class="ideal__action">
        <button id="ideal-submit" class="ideal__submit-btn">Armar Pedido Ideal</button>
      </div>

      <IdealResultArea />
    </div>
  </section>
  </div>
  <CartHydration />
</Layout>

<script>
  import { initIdealPage } from '../scripts/ideal';
  import { initProductRevalidation } from '../scripts/productRevalidation';
  import { readCatalogFromElement } from '../utils/catalogSerializer';

  const products = readCatalogFromElement();

  const { ProductSchema } = await import('../schemas/product');
  const validated = ProductSchema.array().safeParse(products);
  initIdealPage(validated.success ? validated.data : []);
  initProductRevalidation();
</script>

<style>
  @import "../styles/breakpoints.css";
  .ideal {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  @media (--bp-lg-down) {
    .ideal {
      padding-top: calc(var(--header-height-mobile) + var(--space-xl));
    }
  }

  .ideal__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  @media (--bp-sm-down) {
    .ideal__header {
      margin-bottom: var(--space-lg);
    }
  }

  .ideal__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-sm);
  }

  .ideal__subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 520px;
    margin: 0 auto;
  }

  .ideal__action {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .ideal__submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-brand);
    border: none;
    border-radius: 14px;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    line-height: 1.2;
    cursor: pointer;
    min-height: 56px;
  }

  @media (--bp-sm-down) {
    .ideal__action {
      position: sticky;
      bottom: var(--space-md);
      z-index: 40;
      margin-bottom: var(--space-lg);
    }

    .ideal__submit-btn {
      width: 100%;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
  }

  .ideal__submit-btn:hover {
    opacity: 0.9;
  }

  .ideal__submit-btn:active {
    transform: scale(0.97);
  }

  .ideal__submit-btn:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
