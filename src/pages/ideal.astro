---
import Layout from '../layouts/Layout.astro';
import CartHydration from '../components/cart/CartHydration.astro';
import { fetchCSVProducts } from '../data/csvProducts';
import { products as fallbackProducts } from '../data/products';
import type { Product } from '../types/Product';

const csvProducts = await fetchCSVProducts();
const products: Product[] = csvProducts.length > 0 ? csvProducts : fallbackProducts;
const serialized = JSON.stringify(products);
---

<Layout
  title="Tu Pedido Ideal — Bajo Cero"
  description="Respondé dos preguntas y te armamos el combo perfecto de productos congelados."
>
  <div id="ideal-data" data-products={serialized ?? '[]'} aria-hidden="true" style="display:none"></div>
  <div id="ideal-container">
  <section class="ideal">
    <div class="container">
      <header class="ideal__header">
        <h1 class="ideal__title">Tu Pedido Ideal</h1>
        <p class="ideal__subtitle">
          Elegí cuánto querés gastar o cuántos son para comer, y te armamos el combo perfecto en un clic.
        </p>
      </header>

      <div class="ideal__filters" id="ideal-filters">
        <div class="ideal__filter-group" data-filter="budget">
          <p class="ideal__filter-label">Presupuesto</p>
          <div class="ideal__pills">
            <button class="ideal__pill" data-value="5000">$5.000</button>
            <button class="ideal__pill" data-value="10000">$10.000</button>
            <button class="ideal__pill" data-value="20000">$20.000</button>
            <button class="ideal__pill ideal__pill--any" data-value="">Cualquier presupuesto</button>
          </div>
          <input
            class="ideal__input"
            type="number"
            inputmode="numeric"
            placeholder="Otro monto (Ej: 13500)"
            data-input="budget"
            min="0"
          />
        </div>

        <div class="ideal__filter-group" data-filter="comensales">
          <p class="ideal__filter-label">Comensales</p>
          <div class="ideal__pills">
            <button class="ideal__pill" data-value="2">Somos 2</button>
            <button class="ideal__pill" data-value="4">Somos 4</button>
            <button class="ideal__pill" data-value="6">Somos 6 o más</button>
            <button class="ideal__pill ideal__pill--any" data-value="">No especificar</button>
          </div>
          <input
            class="ideal__input"
            type="number"
            inputmode="numeric"
            placeholder="Cuántos son (Ej: 5)"
            data-input="comensales"
            min="1"
          />
        </div>

        <div class="ideal__filter-group" data-filter="intention">
          <p class="ideal__filter-label">¿Qué buscás?</p>
          <div class="ideal__pills">
            <button class="ideal__pill" data-value="variado">Variado</button>
            <button class="ideal__pill" data-value="rapido">Rápido (Horno/Sartén)</button>
            <button class="ideal__pill" data-value="saludable">Saludable/Liviano</button>
          </div>
        </div>
      </div>

      <div class="ideal__action">
        <button id="ideal-submit" class="ideal__submit-btn">Armar Pedido Ideal</button>
      </div>

      <div id="resultado-combo" class="ideal__result" aria-live="polite">
        <div class="ideal__idle">
          <p class="ideal__idle-text">Completá las opciones de arriba y presioná <strong>Armar Pedido Ideal</strong> para obtener tu combo.</p>
        </div>
      </div>

      <template id="ideal-loading">
        <div class="ideal__loading">
          <span class="ideal__loading-dots">
            <span class="ideal__loading-dot"></span>
            <span class="ideal__loading-dot"></span>
            <span class="ideal__loading-dot"></span>
          </span>
          <p class="ideal__loading-text">Buscando tu pedido ideal...</p>
        </div>
      </template>

      <template id="ideal-result-ok">
        <div class="ideal__combo ideal__combo--enter">
          <div class="ideal__combo-items" data-part="items"></div>
          <div class="ideal__combo-total">
            <span class="ideal__combo-total-label">Total a pagar</span>
            <span class="ideal__combo-total-value" data-part="total"></span>
          </div>
          <p class="ideal__combo-remaining" data-part="remaining"></p>
          <button class="ideal__combo-btn" data-part="add-btn">Agregar Combo al Carrito</button>
        </div>
      </template>

      <template id="ideal-result-empty">
        <div class="ideal__empty">
          <p class="ideal__empty-text">No encontramos un combo con esos filtros. Probá cambiando el presupuesto o la cantidad de comensales.</p>
        </div>
      </template>

      <template id="ideal-result-item">
        <div class="ideal__combo-item">
          <div class="ideal__combo-item-info">
            <span class="ideal__combo-item-name" data-part="name"></span>
            <span class="ideal__combo-item-detail" data-part="detail"></span>
          </div>
          <span class="ideal__combo-item-price" data-part="price"></span>
        </div>
      </template>
    </div>
  </section>
  </div>
  <CartHydration />
</Layout>

<script>
  import { initIdealPage } from '../scripts/idealPage';

  const dataEl = document.getElementById('ideal-data');
  const raw = dataEl?.dataset.products;
  let products: unknown[] = [];
  if (raw) {
    try {
      products = JSON.parse(raw) as unknown[];
    } catch (e) {
      if (import.meta.env.DEV) console.error('[ideal] JSON parse error on page data:', e);
    }
  }

  const { ProductSchema } = await import('../schemas/product');
  const validated = ProductSchema.array().safeParse(products);
  initIdealPage(validated.success ? validated.data : []);
</script>

<style>
  .ideal {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  @media (max-width: 1023px) {
    .ideal {
      padding-top: calc(var(--header-height-mobile) + var(--space-xl));
    }
  }

  .ideal__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .ideal__title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-sm);
  }

  .ideal__subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 520px;
    margin: 0 auto;
  }

  .ideal__filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .ideal__filter-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ideal__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .ideal__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
    line-height: 1.2;
    cursor: pointer;
    min-height: 44px;
    user-select: none;
  }

  .ideal__pill:hover {
    border-color: rgba(var(--color-brand-rgb), 0.3);
    color: var(--color-text);
  }

  .ideal__pill:active {
    transform: scale(0.96);
  }

  .ideal__pill--active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-text);
  }

  .ideal__input {
    margin-top: var(--space-sm);
    display: block;
    width: 100%;
    max-width: 260px;
    padding: 10px 16px;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    outline: none;
    font-family: inherit;
    line-height: 1.4;
    transition: border-color var(--transition-fast);
    -moz-appearance: textfield;
  }

  .ideal__input::-webkit-outer-spin-button,
  .ideal__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .ideal__input::placeholder {
    color: var(--color-text-tertiary);
  }

  .ideal__input:focus {
    border-color: var(--color-brand);
  }

  .ideal__action {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .ideal__submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-brand);
    border: none;
    border-radius: 14px;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    line-height: 1.2;
    cursor: pointer;
    min-height: 56px;
  }

  .ideal__submit-btn:hover {
    opacity: 0.9;
  }

  .ideal__submit-btn:active {
    transform: scale(0.97);
  }

  .ideal__submit-btn:disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .ideal__result {
    min-height: 200px;
    display: flex;
    justify-content: center;
  }

  .ideal__idle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
    text-align: center;
  }

  .ideal__idle-text {
    font-size: var(--font-size-base);
    color: var(--color-text-tertiary);
    line-height: 1.6;
    max-width: 380px;
  }

  .ideal__loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
  }

  .ideal__loading-dots {
    display: flex;
    gap: 8px;
  }

  .ideal__loading-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-brand);
    animation: loading-dot 1.2s ease-in-out infinite;
  }

  .ideal__loading-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .ideal__loading-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes loading-dot {
    0%, 80%, 100% {
      opacity: 0.15;
      transform: scale(0.75);
    }
    40% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .ideal__loading-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.5;
    font-weight: 500;
  }

  .ideal__combo {
    width: 100%;
    max-width: 500px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .ideal__combo--enter {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .ideal__combo--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ideal__combo-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ideal__combo-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .ideal__combo-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ideal__combo-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .ideal__combo-item-name {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .ideal__combo-item-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    line-height: 1.4;
  }

  .ideal__combo-item-price {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ideal__combo-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .ideal__combo-total-label {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .ideal__combo-total-value {
    font-size: var(--font-size-xl);
    font-weight: 800;
    color: var(--color-brand);
  }

  .ideal__combo-remaining {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    text-align: center;
    line-height: 1.4;
  }

  .ideal__combo-remaining--hidden {
    display: none;
  }

  .ideal__combo-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 18px var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-brand);
    border: none;
    border-radius: 14px;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
    line-height: 1.2;
    cursor: pointer;
    min-height: 56px;
  }

  .ideal__combo-btn:hover {
    opacity: 0.9;
  }

  .ideal__combo-btn:active {
    transform: scale(0.97);
  }

  .ideal__combo-btn--done {
    background: #22c55e;
    pointer-events: none;
  }

  .ideal__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--space-lg);
    text-align: center;
  }

  .ideal__empty-text {
    font-size: var(--font-size-base);
    color: var(--color-text-tertiary);
    line-height: 1.6;
    max-width: 380px;
  }
</style>
