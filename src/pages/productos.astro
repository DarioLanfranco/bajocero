---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import Icon from '../components/ui/Icon.astro';
import CartHydration from '../components/cart/CartHydration.astro';
import { products as fallbackProducts } from '../data/products';
import { fetchCSVProducts } from '../data/csvProducts';

const csvProducts = await fetchCSVProducts();
const products = csvProducts.length > 0 ? csvProducts : fallbackProducts;
---

<Layout
  title="Catálogo completo — Bajo Cero"
  description="Explorá todos los productos congelados de Bajo Cero. Buscá por nombre, filtrá en tiempo real y armá tu pedido."
>
  <section class="catalog-page" id="catalog-page">
    <div class="catalog-page__container container">
      <div class="catalog-page__header">
        <SectionHeading
          eyebrow="Catálogo"
          titleStart="Todos los productos"
        />
        <button class="catalog-page__pdf-btn" data-pdf-export aria-label="Descargar lista de precios en PDF">
          <svg class="catalog-page__pdf-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span class="catalog-page__pdf-label">Descargar PDF</span>
        </button>
      </div>

      <div class="catalog-page__search">
        <div class="catalog-page__search-icon" aria-hidden="true">
          <Icon name="search" size={18} strokeWidth={2} />
        </div>
        <input
          class="catalog-page__search-input"
          type="text"
          placeholder="Buscar producto..."
          aria-label="Buscar productos por nombre o descripción"
          autocomplete="off"
          spellcheck="false"
          data-catalog-role="search-input"
        />
        <span class="catalog-page__search-count">
          <span data-catalog-role="count">0</span> productos
        </span>
      </div>

      <!-- Product grid — SSR all products, JS manages visibility -->
      <div class="catalog-page__grid" data-catalog-role="grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <!-- Empty state -->
      <div class="catalog-page__empty hidden" data-catalog-role="empty">
        <Icon name="search-off" size={48} strokeWidth={1.5} />
        <p class="catalog-page__empty-text">No se encontraron productos que coincidan con tu búsqueda.</p>
        <button class="catalog-page__empty-btn" data-catalog-role="clear-btn">Limpiar búsqueda</button>
      </div>

      <!-- Load more -->
      <div class="catalog-page__load-wrap">
        <button class="catalog-page__load-btn hidden" data-catalog-role="load-more">
          Cargar más productos
        </button>
      </div>
    </div>
  </section>

  <div id="pdf-products-data" data-products={JSON.stringify(products ?? [])} aria-hidden="true" style="display:none"></div>
  <CartHydration />
</Layout>

<script>
  import('../scripts/catalogInteraction').then((m) => m.initCatalogInteraction()).catch(() => {});
  import('../scripts/catalogSearch').then((m) => m.initCatalogSearch('catalog-page', 10)).catch(() => {});

  function loadCatalogProducts(): unknown[] {
    const el = document.getElementById('pdf-products-data');
    const raw = el?.dataset.products;
    if (!raw) return [];
    try {
      return JSON.parse(raw);
    } catch (e) {
      if (import.meta.env.DEV) console.error('[productos] JSON parse error on catalog data:', e);
      return [];
    }
  }

  const rawProducts = loadCatalogProducts();

  const {
    ProductSchema,
  } = await import('../schemas/product');

  const validated = ProductSchema.array().safeParse(rawProducts);
  const currentProducts = validated.success ? validated.data : [];

  const pdfBtn = document.querySelector<HTMLButtonElement>('[data-pdf-export]');
  if (pdfBtn) {
    const labelEl = pdfBtn.querySelector('.catalog-page__pdf-label')!;
    const originalLabel = labelEl.textContent!;
    pdfBtn.addEventListener('click', async () => {
      pdfBtn.disabled = true;
      labelEl.textContent = 'Generando...';
      try {
        const { exportCatalogToPdf } = await import('../scripts/pdfExport');
        await exportCatalogToPdf(currentProducts);
        labelEl.textContent = '¡Descargado!';
        setTimeout(() => { labelEl.textContent = originalLabel; pdfBtn.disabled = false; }, 2000);
      } catch {
        labelEl.textContent = 'Error al generar PDF';
        setTimeout(() => { labelEl.textContent = originalLabel; pdfBtn.disabled = false; }, 3000);
      }
    });
  }
</script>

<style>
  .catalog-page {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  @media (max-width: 1023px) {
    .catalog-page {
      padding-top: calc(var(--header-height-mobile) + var(--space-xl));
    }
  }

  .catalog-page__header {
    margin-bottom: var(--space-xl);
  }

  /* Search */
  .catalog-page__search {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 12px 16px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2xl);
  }

  .catalog-page__search:focus-within {
    border-color: var(--color-brand);
  }

  .catalog-page__search-icon {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }

  .catalog-page__search-input {
    flex: 1;
    font-size: var(--font-size-base);
    color: var(--color-text);
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    line-height: 1.5;
  }

  .catalog-page__search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .catalog-page__search-count {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Grid */
  .catalog-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .catalog-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .catalog-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .catalog-page__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Empty state */
  .catalog-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    padding: var(--space-3xl) var(--space-lg);
    color: var(--color-text-tertiary);
  }

  .catalog-page__empty.hidden {
    display: none;
  }

  .catalog-page__empty svg {
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-sm);
  }

  .catalog-page__empty-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .catalog-page__empty-btn {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-brand);
    padding: 8px 20px;
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  @media (hover: hover) {
    .catalog-page__empty-btn:hover {
      background: rgba(var(--color-brand-rgb), 0.08);
    }
  }

  /* Load more */
  .catalog-page__load-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xl);
  }

  .catalog-page__load-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 40px;
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-brand);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .catalog-page__load-btn.hidden {
    display: none;
  }

  @media (hover: hover) {
    .catalog-page__load-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(var(--color-brand-rgb), 0.3);
    }
  }

  .catalog-page__load-btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .catalog-page__pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    margin-top: var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
    line-height: 1.2;
  }
  .catalog-page__pdf-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-text);
  }
  .catalog-page__pdf-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .catalog-page__pdf-icon {
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .catalog-page__pdf-btn {
      margin-top: 0;
    }
    .catalog-page__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>

<style is:global>
  [data-catalog-role="grid"] .product-card.is-hidden {
    display: none;
  }
</style>
