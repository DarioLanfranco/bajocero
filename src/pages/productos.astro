---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProductCard from '../components/catalog/ProductCard.astro';
import CatalogSearch from '../components/catalog/CatalogSearch.astro';
import CatalogEmptyState from '../components/catalog/CatalogEmptyState.astro';
import CatalogPdfButton from '../components/catalog/CatalogPdfButton.astro';
import CartHydration from '../components/cart/CartHydration.astro';
import { products as fallbackProducts } from '../data/products';
import { fetchCSVProducts } from '../data/csvProducts';

const csvProducts = await fetchCSVProducts();
const products = csvProducts.length > 0 ? csvProducts : fallbackProducts;
---

<Layout
  title="Catálogo completo — Bajo Cero"
  description="Explorá todos los productos congelados de Bajo Cero. Buscá por nombre, filtrá en tiempo real y armá tu pedido."
>
  <section class="catalog-page" id="catalog-page">
    <div class="catalog-page__container container">
      <div class="catalog-page__header">
        <SectionHeading
          eyebrow="Catálogo"
          titleStart="Todos los productos"
        />
        <CatalogPdfButton />
      </div>

      <CatalogSearch />

      <div class="catalog-page__grid" data-catalog-role="grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <CatalogEmptyState />

      <div class="catalog-page__load-wrap">
        <button class="catalog-page__load-btn hidden" data-catalog-role="load-more">
          Cargar más productos
        </button>
      </div>
    </div>
  </section>

  <div id="pdf-products-data" data-products={JSON.stringify(products ?? [])} aria-hidden="true" style="display:none"></div>
  <CartHydration />
</Layout>

<script>
  import('../scripts/catalogInteraction').then((m) => m.initCatalogInteraction()).catch(() => {});
  import('../scripts/catalogSearch').then((m) => m.initCatalogSearch('catalog-page', 10)).catch(() => {});
  import('../scripts/productRevalidation').then((m) => m.initProductRevalidation()).catch(() => {});

  function loadCatalogProducts(): unknown[] {
    const el = document.getElementById('pdf-products-data');
    const raw = el?.dataset.products;
    if (!raw) return [];
    try {
      return JSON.parse(raw);
    } catch (e) {
      if (import.meta.env.DEV) console.error('[productos] JSON parse error on catalog data:', e);
      return [];
    }
  }

  const rawProducts = loadCatalogProducts();

  const {
    ProductSchema,
  } = await import('../schemas/product');

  const validated = ProductSchema.array().safeParse(rawProducts);
  const currentProducts = validated.success ? validated.data : [];

  const pdfBtn = document.querySelector<HTMLButtonElement>('[data-pdf-export]');
  if (pdfBtn) {
    const labelEl = pdfBtn.querySelector('.catalog-page__pdf-label')!;
    const originalLabel = labelEl.textContent!;
    pdfBtn.addEventListener('click', async () => {
      pdfBtn.disabled = true;
      labelEl.textContent = 'Generando...';
      try {
        const freshProducts = loadCatalogProducts();
        const revalidated = ProductSchema.array().safeParse(freshProducts);
        const exportProducts = revalidated.success ? revalidated.data : currentProducts;
        const { exportCatalogToPdf } = await import('../scripts/pdfExport');
        await exportCatalogToPdf(exportProducts);
        labelEl.textContent = '¡Descargado!';
        setTimeout(() => { labelEl.textContent = originalLabel; pdfBtn.disabled = false; }, 2000);
      } catch {
        labelEl.textContent = 'Error al generar PDF';
        setTimeout(() => { labelEl.textContent = originalLabel; pdfBtn.disabled = false; }, 3000);
      }
    });
  }
</script>

<style>
  .catalog-page {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-3xl);
  }

  @media (max-width: 1023px) {
    .catalog-page {
      padding-top: calc(var(--header-height-mobile) + var(--space-xl));
    }
  }

  .catalog-page__header {
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 768px) {
    .catalog-page__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .catalog-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .catalog-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .catalog-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .catalog-page__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .catalog-page__load-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xl);
  }

  .catalog-page__load-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 40px;
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-brand);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .catalog-page__load-btn.hidden {
    display: none;
  }

  @media (hover: hover) {
    .catalog-page__load-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(var(--color-brand-rgb), 0.3);
    }
  }

  .catalog-page__load-btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }
</style>

<style is:global>
  [data-catalog-role="grid"] .product-card.is-hidden {
    display: none;
  }
</style>
