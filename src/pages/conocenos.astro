---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import StatusBadge from "../components/ui/StatusBadge.astro";
import Location from "../components/sections/Location.astro";
import { business } from "../data/business";

import historyImg from "../assets/images/history/history.webp";
import insta1 from "../assets/images/Instagram/history1.webp";
import insta2 from "../assets/images/Instagram/history2.webp";
import insta3 from "../assets/images/Instagram/history3.webp";
import insta4 from "../assets/images/Instagram/history4.webp";

const instagramImages = [insta1, insta2, insta3];

const instaUrl = `https://www.instagram.com/${business.instagram}/`;
---

<Layout title="Conócenos — Bajo Cero">
  <section class="history" data-reveal>
    <div class="history__container container">
      <div class="history__grid">
        <div class="history__content" data-reveal>
          <SectionHeading
            eyebrow="Nuestra Historia"
            titleStart="Más simples,"
            titleAccent="más rápidos"
          />

          <div class="history__text">
            <p>
              Bajo Cero nace del encuentro de cuatro parejas —Alva y Vicky F.,
              Facu y Vicky P., Agus y Agustina, Dario y Ro— que compartían una
              misma pregunta: ¿Existe en Río Cuarto un lugar que reúna la mayor
              variedad de congelados ricos, prácticos y a buen precio?
            </p>
            <p>
              La respuesta fue crear lo que parecía imposible: un punto de
              encuentro donde llegás, elegís en segundos y te resolvés la
              semana. Sin vueltas, sin perder tiempo y sin pagar de más.
            </p>
            <p>
              Creemos en una cocina que no pide permiso: sin horarios rígidos,
              sin porciones tristes y sin renunciar al placer de comer bien. Es
              abrir la puerta del freezer y olvidarte del eterno “¿qué comemos
              hoy?”, “¿qué le preparo a los chicos?” o del cansancio después de
              trabajar.
            </p>
            <p>
              Seleccionamos cada producto de nuestra tienda para asegurarnos de
              que lleves a tu mesa comida real, rica y equilibrada en
              nutrientes.
            </p>
            <p><b>Abrís tu freezer, problema solucionado.</b></p>
            <p class="history__signature">
              — Alva, Vicky F., Facu, Vicky P., Agus, Agustina, Dario & Ro
            </p>
          </div>
        </div>

        <div class="history__image" data-reveal data-reveal-delay="100">
          <img
            class="history__img"
            src={historyImg.src}
            alt="Historia de Bajo Cero - Dos fuegos, una mesa"
            width={historyImg.width}
            height={historyImg.height}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="feed" aria-label="Galería de Instagram" data-reveal>
    <div class="feed__container container">
      <div class="feed__header" data-reveal>
        <SectionHeading
          eyebrow="Instagram"
          titleStart="Vida en"
          titleAccent="Bajo Cero"
        />
      </div>

      <ul class="feed__grid" data-reveal data-reveal-delay="100">
        {
          instagramImages.map((img) => (
            <li class="feed__item">
              <a
                href={instaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="feed__link"
              >
                <img
                  class="feed__img"
                  src={img.src}
                  alt="Bajo Cero - Instagram"
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                />
              </a>
            </li>
          ))
        }
        <li class="feed__item feed__item--cta">
          <a
            href={instaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="insta-cta"
          >
            <img
              class="insta-cta__bg"
              src={insta4.src}
              alt="Conocé más de nuestra historia en Instagram"
              width={insta4.width}
              height={insta4.height}
              loading="lazy"
            />
            <div class="insta-cta__overlay" aria-hidden="true"></div>
            <div class="insta-cta__content">
              <span class="insta-cta__label"
                >Conocé más de nuestra historia</span
              >
              <span class="insta-cta__handle">@{business.instagram} ➔</span>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="location-page" data-reveal>
    <div class="container">
      <div class="location-page__badge" data-reveal>
        <StatusBadge />
      </div>
    </div>
    <Location />
  </section>
</Layout>

<style>
  .history {
    padding: var(--space-3xl) 0;
  }

  .history__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .history__content {
    order: 1;
  }

  .history__image {
    order: 2;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .history__image::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(var(--color-brand-rgb), 0.15);
    border-radius: 20px;
    pointer-events: none;
  }

  .history__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 20px;
    transition: transform var(--transition-normal);
  }

  @media (hover: hover) {
    .history__image:hover .history__img {
      transform: scale(1.03);
    }
  }

  .history__text {
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-top: var(--space-xl);
  }

  .history__text p {
    margin-bottom: var(--space-lg);
  }

  .history__text p:last-child {
    margin-bottom: 0;
  }

  .history__signature {
    font-style: italic;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-sm);
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .history {
      padding: 96px 0;
    }

    .history__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3xl);
    }

    .history__content {
      order: 0;
    }

    .history__image {
      order: 0;
    }
  }

  .feed {
    padding: var(--space-3xl) 0;
    background-color: rgba(var(--color-brand-rgb), 0.02);
  }

  @media (min-width: 1024px) {
    .feed {
      padding: 96px 0;
    }
  }

  .feed__header {
    margin-bottom: var(--space-2xl);
  }

  .feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feed__item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface-subtle);
  }

  .feed__item::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(var(--color-brand-rgb), 0.1);
    border-radius: 16px;
    pointer-events: none;
    z-index: 5;
  }

  .feed__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .feed__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .feed__link:hover .feed__img {
      transform: scale(1.03);
      filter: brightness(1.06) saturate(1.12);
    }
  }

  /* --- CTA card (foto5) --- */

  .feed__item--cta {
    overflow: hidden;
  }

  .insta-cta {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .insta-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .insta-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.45) 50%,
      rgba(0, 0, 0, 0.2) 100%
    );
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .insta-cta:hover .insta-cta__overlay {
      opacity: 0.75;
    }
  }

  .insta-cta__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .insta-cta:hover .insta-cta__content {
      transform: translateY(-5px);
    }
  }

  .insta-cta__label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: var(--space-md);
    line-height: 1.4;
  }

  .insta-cta__handle {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.3px;
    transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .insta-cta:hover .insta-cta__handle {
      color: var(--color-brand);
    }
  }

  @media (min-width: 768px) {
    .feed__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .location-page {
    padding-top: var(--space-3xl);
  }

  .location-page__badge {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }
</style>
