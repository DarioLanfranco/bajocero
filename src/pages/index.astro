---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Location from '../components/sections/Location.astro';
import Reviews from '../components/sections/Reviews.astro';
import FaqSection from '../components/FaqSection.astro';
import ProductCarousel from '../components/catalog/ProductCarousel.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CartHydration from '../components/cart/CartHydration.astro';
import { faqItems } from '../data/faq';
import { fetchCSVProducts } from '../data/csvProducts';
import { products as fallbackProducts } from '../data/products';
import { toGroupCarousels, productInRange, PRODUCT_GROUPS } from '../data/catalog';
import type { GroupCarousel } from '../data/catalog';

const csvProducts = await fetchCSVProducts();
const allProducts = csvProducts.length > 0 ? csvProducts : fallbackProducts;

const groups: GroupCarousel[] = toGroupCarousels();
---

<Layout>
  <Hero />
  <About />

  <section class="catalog" id="productos" aria-label="Catálogo de productos" data-reveal>
    <div class="catalog__container container">
      <div class="catalog__header" data-reveal>
        <SectionHeading
          eyebrow="Productos"
          titleStart="Tu freezer,"
          titleAccent="tu mejor aliado"
        />
      </div>

      {groups.map(({ category }) => {
        const group = PRODUCT_GROUPS.find((g) => g.id === category.id);
        if (!group) return null;
        const groupProducts = allProducts
          .filter((p) => productInRange(p, group))
          .slice(0, 4);
        if (groupProducts.length === 0) return null;
        return <ProductCarousel category={category} products={groupProducts} />;
      })}
    </div>
  </section>

  <Reviews />
  <Location />
  <FaqSection items={faqItems} />
  <CartHydration />
</Layout>

<script>
  import { initCatalogInteraction } from '../scripts/catalogInteraction';
  import { initProductRevalidation } from '../scripts/productRevalidation';
  initCatalogInteraction();
  initProductRevalidation();
</script>

<style>
  .catalog {
    padding: var(--space-3xl) 0;
  }

  .catalog__header {
    margin-bottom: var(--space-2xl);
  }

  @media (min-width: 1024px) {
    .catalog {
      padding: 96px 0;
    }
  }
</style>
